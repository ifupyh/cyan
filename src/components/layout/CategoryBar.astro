---
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import { getCategoryList, getSortedPostsList } from "@/utils/content-utils";
import { url } from "@/utils/url-utils";

interface Props {
	currentPostCategory?: string;
}

const { currentPostCategory } = Astro.props as Props;

const categories = await getCategoryList();
const totalPosts = (await getSortedPostsList()).length;
const postsUrl = url("/posts/");
const archiveUrl = url("/archive/");
const categoriesUrl = url("/categories/");
const tagsUrl = url("/tags/");
const changelogUrl = url("/changelog/");
const blogChangelogUrl = url("/blog-changelog/");

// 分类栏在文章列表、归档、分类、标签、项目更新日志、博客日志页显示
const isCategoryBarPath =
	/^\/posts\/?$/.test(Astro.url.pathname) ||
	/^\/posts\/page\/\d+\/?$/.test(Astro.url.pathname) ||
	/^\/archive\/?$/.test(Astro.url.pathname) ||
	/^\/categories\/?$/.test(Astro.url.pathname) ||
	/^\/tags\/?$/.test(Astro.url.pathname) ||
	/^\/changelog\/?$/.test(Astro.url.pathname) ||
	/^\/blog-changelog\/?$/.test(Astro.url.pathname);
---

<div
  class:list={[
    "category-bar p-3 onload-animation",
    !isCategoryBarPath && "hidden",
  ]}
  id="category-bar"
  data-posts-path={postsUrl}
  data-archive-path={archiveUrl}
  data-categories-path={categoriesUrl}
  data-tags-path={tagsUrl}
  data-changelog-path={changelogUrl}
  data-blog-changelog-path={blogChangelogUrl}
  data-current-post-category={currentPostCategory || ""}
>
  <div class="category-bar-inner flex gap-2">
    <a
      href={postsUrl}
      class="category-pill text-sm px-4 py-1.5 whitespace-nowrap shrink-0
             transition-colors duration-150 ease-out flex items-center justify-center"
      data-category-name="__posts__"
    >
      文章
    </a>
    <a
      href={archiveUrl}
      class="category-pill text-sm px-4 py-1.5 whitespace-nowrap shrink-0
             transition-colors duration-150 ease-out flex items-center justify-center"
      data-category-name="__archive__"
    >
      {i18n(I18nKey.archive)}
      <span class="pill-count">{totalPosts}</span>
    </a>
    <a
      href={categoriesUrl}
      class="category-pill text-sm px-4 py-1.5 whitespace-nowrap shrink-0
             transition-colors duration-150 ease-out flex items-center justify-center"
      data-category-name="__categories__"
    >
      {i18n(I18nKey.categories)}
    </a>
    <a
      href={tagsUrl}
      class="category-pill text-sm px-4 py-1.5 whitespace-nowrap shrink-0
             transition-colors duration-150 ease-out flex items-center justify-center"
      data-category-name="__tags__"
    >
      {i18n(I18nKey.tags)}
    </a>
    <a
      href={changelogUrl}
      class="category-pill text-sm px-4 py-1.5 whitespace-nowrap shrink-0
             transition-colors duration-150 ease-out flex items-center justify-center"
      data-category-name="__changelog__"
    >
      项目更新日志
    </a>
    <a
      href={blogChangelogUrl}
      class="category-pill text-sm px-4 py-1.5 whitespace-nowrap shrink-0
             transition-colors duration-150 ease-out flex items-center justify-center"
      data-category-name="__blog-changelog__"
    >
      博客日志
    </a>
    <div class="category-divider shrink-0"></div>
    <div class="scroll-area relative">
      <div class="scroll-fade scroll-fade-left" aria-hidden="true"></div>
      <div class="category-scroll flex gap-2 overflow-x-auto">
        {
          categories.map((cat) => (
            <a
              href={cat.url}
              class="category-pill text-sm px-4 py-1.5 whitespace-nowrap
                     transition-colors duration-150 ease-out flex items-center justify-center"
              data-category-name={cat.name}
            >
              {cat.name}
              <span class="pill-count">{cat.count}</span>
            </a>
          ))
        }
      </div>
      <div class="scroll-fade scroll-fade-right" aria-hidden="true"></div>
    </div>
  </div>
</div>

<style>
  .category-bar {
    margin-bottom: 1rem;
  }
  .category-divider {
    width: 1px;
    align-self: stretch;
    background: var(--line-divider);
    opacity: 0.5;
  }
  .more-divider {
    opacity: 0;
    transition: opacity 300ms ease-in-out;
  }
  .more-divider[data-visible] {
    opacity: 0.5;
  }
  .scroll-area {
    flex: 1;
    min-width: 0;
    position: relative;
  }
  .scroll-fade {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 2.5rem;
    pointer-events: none;
    opacity: 0;
    transition: opacity 300ms ease-in-out;
    z-index: 1;
  }
  .scroll-fade[data-visible] {
    opacity: 1;
  }
  .scroll-fade-left {
    left: 0;
    background: linear-gradient(to left, transparent, var(--card-bg));
  }
  .scroll-fade-right {
    right: 0;
    background: linear-gradient(to right, transparent, var(--card-bg));
  }
  :global(body.wallpaper-transparent) .scroll-fade {
    display: none;
  }
  .category-scroll {
    scrollbar-width: none;
    -ms-overflow-style: none;
    scroll-behavior: smooth;
  }
  .category-scroll::-webkit-scrollbar {
    display: none;
  }
  .category-pill {
    border: none;
    color: var(--btn-content);
    font-weight: 500;
    gap: 0.375rem;
    position: relative;
  }
  .category-pill .pill-count {
    font-size: 0.7rem;
    font-weight: 600;
    opacity: 0.5;
  }
  .category-pill::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: 2px;
    width: 0;
    height: 2px;
    border-radius: 999px;
    background: #f472b6;
    transform: translateX(-50%);
    transition: width 0.25s ease;
    pointer-events: none;
  }
  .category-pill:hover {
    color: var(--primary);
  }
  .category-pill:hover::after,
  .category-pill[data-active]::after,
  .category-pill[data-soft-active]::after {
    width: 55%;
  }
  .category-pill[data-active],
  .category-pill[data-soft-active] {
    color: #f472b6;
    font-weight: 600;
  }
</style>

<script>
  let delayedCategoryBarScrollTimer: number | undefined;

  function getCategoryBarState(bar: HTMLElement, currentUrl: URL) {
    const pathname = currentUrl.pathname.replace(/\/$/, "");
    const postsPath = (bar.getAttribute("data-posts-path") || "/posts").replace(/\/$/, "");
    const archivePath = (bar.getAttribute("data-archive-path") || "/archive").replace(/\/$/, "");
    const categoriesPath = (bar.getAttribute("data-categories-path") || "/categories").replace(/\/$/, "");
    const tagsPath = (bar.getAttribute("data-tags-path") || "/tags").replace(/\/$/, "");
    const changelogPath = (bar.getAttribute("data-changelog-path") || "/changelog").replace(/\/$/, "");
    const blogChangelogPath = (bar.getAttribute("data-blog-changelog-path") || "/blog-changelog").replace(/\/$/, "");
    const isPosts = pathname === postsPath;
    const isArchive = pathname === archivePath;
    const isCategories = pathname === categoriesPath;
    const isTags = pathname === tagsPath;
    const isChangelog = pathname === changelogPath;
    const isBlogChangelog = pathname === blogChangelogPath;

    return {
      isPosts,
      isArchive,
      isCategories,
      isTags,
      isChangelog,
      isBlogChangelog,
      activeCategory: currentUrl.searchParams.get("category") || "",
      hasTag: currentUrl.searchParams.has("tag"),
      hasUncategorized: currentUrl.searchParams.has("uncategorized"),
    };
  }

  function setActiveCategory(bar: HTMLElement, currentUrl: URL) {
    const { isPosts, isArchive, isCategories, isTags, isChangelog, isBlogChangelog, activeCategory, hasTag, hasUncategorized } =
      getCategoryBarState(bar, currentUrl);
    const postCategory = (bar.getAttribute("data-current-post-category") || "").trim();

    const pills = bar.querySelectorAll<HTMLAnchorElement>(".category-pill");
    pills.forEach((pill) => {
      pill.removeAttribute("data-active");
      pill.removeAttribute("data-soft-active");
    });

    if (isPosts) {
      bar.querySelector<HTMLAnchorElement>('.category-pill[data-category-name="__posts__"]')
        ?.setAttribute("data-active", "");
      return;
    }

    if (isCategories) {
      bar.querySelector<HTMLAnchorElement>('.category-pill[data-category-name="__categories__"]')
        ?.setAttribute("data-active", "");
      return;
    }

    if (isTags) {
      bar.querySelector<HTMLAnchorElement>('.category-pill[data-category-name="__tags__"]')
        ?.setAttribute("data-active", "");
      return;
    }

    if (isChangelog) {
      bar.querySelector<HTMLAnchorElement>('.category-pill[data-category-name="__changelog__"]')
        ?.setAttribute("data-active", "");
      return;
    }

    if (isBlogChangelog) {
      bar.querySelector<HTMLAnchorElement>('.category-pill[data-category-name="__blog-changelog__"]')
        ?.setAttribute("data-active", "");
      return;
    }

    if (activeCategory) {
      pills.forEach((pill) => {
        if (pill.getAttribute("data-category-name") === activeCategory) {
          pill.setAttribute("data-active", "");
        }
      });
      return;
    }

    if (isArchive && !hasTag && !hasUncategorized) {
      bar.querySelector<HTMLAnchorElement>('.category-pill[data-category-name="__archive__"]')
        ?.setAttribute("data-active", "");
      return;
    }

    if (postCategory) {
      pills.forEach((pill) => {
        if (pill.getAttribute("data-category-name") === postCategory) {
          pill.setAttribute("data-soft-active", "");
        }
      });
    }
  }

  function scrollActiveCategoryIntoView(bar: HTMLElement, behavior: ScrollBehavior = "smooth") {
    const activePill =
      bar.querySelector<HTMLAnchorElement>('.category-pill[data-active]') ||
      bar.querySelector<HTMLAnchorElement>('.category-pill[data-soft-active]');
    const scroll = bar.querySelector<HTMLElement>(".category-scroll");
    if (!activePill || !scroll) return;

    const scrollLeft = activePill.offsetLeft - scroll.offsetLeft - (scroll.clientWidth - activePill.offsetWidth) / 2;
    scroll.scrollTo({ left: Math.max(0, scrollLeft), behavior });
  }

  function shouldDeferCategoryScroll(bar: HTMLElement, currentUrl: URL) {
    const { isPosts } = getCategoryBarState(bar, currentUrl);
    const isMobile = window.innerWidth < 1024;
    const isBannerMode = document.body.classList.contains("enable-banner");
    return isMobile && isBannerMode && !isPosts;
  }

  function updateCategoryBar(
    currentUrl = new URL(window.location.href),
    options: { scrollBehavior?: ScrollBehavior; deferScroll?: boolean } = {},
  ) {
    const bar = document.getElementById("category-bar");
    if (!bar) return;

    // 按当前 URL 控制分类栏显隐（文章列表、归档、分类、标签页显示）
    const state = getCategoryBarState(bar, currentUrl);
    const postsPath = (bar.getAttribute("data-posts-path") || "/posts").replace(/\/$/, "");
    const pathname = currentUrl.pathname.replace(/\/$/, "");
    const isPostList = state.isPosts || pathname.startsWith(`${postsPath}/page/`);
    const isBarPage = isPostList || state.isArchive || state.isCategories || state.isTags || state.isChangelog || state.isBlogChangelog;
    bar.classList.toggle("hidden", !isBarPage);
    if (!isBarPage) return;

    const swupContainer = document.getElementById("swup-container");
    if (swupContainer) {
      const currentPostCategory = swupContainer.getAttribute("data-current-post-category") || "";
      bar.setAttribute("data-current-post-category", currentPostCategory);
    }

    setActiveCategory(bar, currentUrl);

    const deferScroll = options.deferScroll ?? shouldDeferCategoryScroll(bar, currentUrl);
    const scrollBehavior = options.scrollBehavior ?? (deferScroll ? "auto" : "smooth");

    if (delayedCategoryBarScrollTimer) {
      window.clearTimeout(delayedCategoryBarScrollTimer);
      delayedCategoryBarScrollTimer = undefined;
    }

    if (deferScroll) {
      // 等主内容上移完成后再定位分类，避免出现“先横向滚动后上移”的卡顿观感。
      delayedCategoryBarScrollTimer = window.setTimeout(() => {
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            scrollActiveCategoryIntoView(bar, scrollBehavior);
            updateScrollHint();
          });
        });
      }, 220);
      return;
    }

    scrollActiveCategoryIntoView(bar, scrollBehavior);
    updateScrollHint();
  }

  function initCategoryBarInteractions() {
    const bar = document.getElementById("category-bar");
    if (!bar || bar.dataset.clickBound === "true") return;

    bar.dataset.clickBound = "true";
    bar.addEventListener("click", (event) => {
      if (!(event.target instanceof Element)) return;

      const pill = event.target.closest<HTMLAnchorElement>(".category-pill");
      if (!pill) return;

      if (
        event.defaultPrevented ||
        event.button !== 0 ||
        event.metaKey ||
        event.ctrlKey ||
        event.shiftKey ||
        event.altKey
      ) {
        return;
      }

      if (pill.target && pill.target !== "_self") return;

      const targetUrl = new URL(pill.href, window.location.href);
      if (targetUrl.origin !== window.location.origin) return;

      setActiveCategory(bar, targetUrl);
      scrollActiveCategoryIntoView(bar, "auto");
    });
  }

  function initScrollFeatures() {
    const bar = document.getElementById("category-bar");
    if (!bar) return;

    const scroll = bar.querySelector<HTMLElement>(".category-scroll");
    if (!scroll) return;

    if (scroll.dataset.featuresBound === "true") {
      updateScrollHint();
      return;
    }
    scroll.dataset.featuresBound = "true";

    // 鼠标滚轮横向滚动
    scroll.addEventListener("wheel", (e) => {
      if (scroll.scrollWidth <= scroll.clientWidth) return;
      e.preventDefault();
      scroll.scrollLeft += e.deltaY;
    }, { passive: false });

    // 监听滚动更新提示图标
    scroll.addEventListener("scroll", updateScrollHint);
    window.addEventListener("resize", updateScrollHint);
    updateScrollHint();
  }

  function updateScrollHint() {
    const bar = document.getElementById("category-bar");
    if (!bar) return;
    const scroll = bar.querySelector<HTMLElement>(".category-scroll");
    const fadeLeft = bar.querySelector<HTMLElement>(".scroll-fade-left");
    const fadeRight = bar.querySelector<HTMLElement>(".scroll-fade-right");
    if (!scroll || !fadeLeft || !fadeRight) return;

    const hasOverflow = scroll.scrollWidth > scroll.clientWidth + 1;
    const atStart = scroll.scrollLeft <= 1;
    const atEnd = scroll.scrollLeft + scroll.clientWidth >= scroll.scrollWidth - 1;

    if (hasOverflow && !atStart) {
      fadeLeft.setAttribute("data-visible", "");
    } else {
      fadeLeft.removeAttribute("data-visible");
    }

    if (hasOverflow && !atEnd) {
      fadeRight.setAttribute("data-visible", "");
    } else {
      fadeRight.removeAttribute("data-visible");
    }

    // 分类溢出时显示"更多"按钮前的分割线
    const moreDivider = bar.querySelector<HTMLElement>(".more-divider");
    if (moreDivider) {
      if (hasOverflow) {
        moreDivider.setAttribute("data-visible", "");
      } else {
        moreDivider.removeAttribute("data-visible");
      }
    }
  }

  updateCategoryBar();
  initCategoryBarInteractions();
  initScrollFeatures();
  document.addEventListener("astro:page-load", () => {
    updateCategoryBar();
    initScrollFeatures();
  });
  document.addEventListener("swup:contentReplaced", () => {
    updateCategoryBar();
    // 某些 swup 生命周期下 URL/DOM 状态同步稍晚，下一帧再校正一次避免状态残留
    requestAnimationFrame(() => {
      updateCategoryBar();
    });
  });

  // 在 Swup 导航时提前更新状态，避免切换期间激活态闪烁
  function setupSwupEarlyUpdate() {
    if (!window.swup?.hooks) return;
    window.swup.hooks.on("visit:start", (visit: any) => {
      const bar = document.getElementById("category-bar");
      if (!bar) return;
      const targetUrl = new URL(visit.to.url, window.location.href);
      setActiveCategory(bar, targetUrl);
    });
  }
  if (window.swup?.hooks) {
    setupSwupEarlyUpdate();
  } else {
    document.addEventListener("swup:enable", setupSwupEarlyUpdate);
  }
</script>
