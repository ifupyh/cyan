---
import type { HeroStickerConfig } from "@/types/config";

interface Props {
	config: HeroStickerConfig;
}

const { config } = Astro.props;
---

<figure class="home-hero__sticker" data-hero-sticker>
	<img
		class="home-hero__sticker-image"
		src={config.image}
		alt={config.alt}
		width="1254"
		height="1254"
		loading="eager"
		decoding="async"
	/>
</figure>
