---
// 主页 widget 聚合区：把原左右侧边栏的 widget 合并成桌面两列 / 移动单列的卡片网格。
// 复用 SideBar 的 componentMap 与 sidebarConfig 的 leftComponents / rightComponents 配置。
import Advertisement from "@/components/widget/Advertisement.astro";
import Announcement from "@/components/widget/Announcement.astro";
import Calendar from "@/components/widget/Calendar.astro";
import Categories from "@/components/widget/Categories.astro";
import Music from "@/components/widget/Music.astro";
import Profile from "@/components/widget/Profile.astro";
import QuoteOfTheDay from "@/components/widget/QuoteOfTheDay.astro";
import ScheduleProgress from "@/components/widget/ScheduleProgress.astro";
import SidebarTOC from "@/components/widget/SidebarTOC.astro";
import SiteInfo from "@/components/widget/SiteInfo.astro";
import SiteStats from "@/components/widget/SiteStats.astro";
import Tags from "@/components/widget/Tags.astro";
import TimeGreeting from "@/components/widget/TimeGreeting.astro";
import { sidebarLayoutConfig } from "@/config";
import type { WidgetComponentConfig } from "@/types/config";

const componentMap = {
	profile: Profile,
	announcement: Announcement,
	categories: Categories,
	tags: Tags,
	sidebarToc: SidebarTOC,
	advertisement: Advertisement,
	stats: SiteStats,
	calendar: Calendar,
	music: Music,
	siteInfo: SiteInfo,
	timeGreeting: TimeGreeting,
	quoteOfTheDay: QuoteOfTheDay,
	scheduleProgress: ScheduleProgress,
};

const ANIMATION_DELAY_UNIT = 50;

// 合并左右侧边栏 widget，主页为非文章页：
// - 启用且非"仅文章页显示"（hideOnNonPostPage !== true）的组件都渲染
const widgets: WidgetComponentConfig[] = [
	...sidebarLayoutConfig.leftComponents,
	...sidebarLayoutConfig.rightComponents,
].filter((comp) => comp.enable && comp.hideOnNonPostPage !== true);
---

<div class="home-widget-grid grid grid-cols-1 md:grid-cols-2 gap-4">
	{
		widgets.map((comp, index) => {
			const Component = componentMap[comp.type];
			if (!Component) return null;
			const props = {
				class: "onload-animation",
				style: `animation-delay: ${index * ANIMATION_DELAY_UNIT}ms`,
				widgetConfig: comp,
			} as any;
			return <Component {...props} />;
		})
	}
</div>
