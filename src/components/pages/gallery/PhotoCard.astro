---
import { getLqipProps } from "@/utils/lqip-utils";

interface Props {
	src: string;
	albumId: string;
	alt?: string;
	index?: number;
	title?: string;
	caption?: string;
}

const { src, albumId, alt = "", index, title, caption } = Astro.props;

// LQIP 渐变占位
const lqipProps = getLqipProps(src, undefined, true);
const frameNo =
	index !== undefined ? `NO. ${String(index).padStart(2, "0")}` : "";
---

<figure class="gallery-photo-card break-inside-avoid mb-6">
	<div
		data-fancybox={`gallery-${albumId}`}
		data-src={src}
		data-type="image"
		class="gallery-photo-card__media group cursor-pointer"
	>
		<div class="lqip-placeholder absolute inset-0 pointer-events-none" style={lqipProps.style} aria-hidden="true"></div>
		<img
			src={src}
			alt={alt || title || ""}
			loading="lazy"
			decoding="async"
			class="w-full h-auto object-cover opacity-0 transition-all duration-500 ease-out group-hover:scale-105"
		/>
	</div>

	{
		(frameNo || title || caption) && (
			<figcaption class="gallery-photo-card__caption">
				<div class="gallery-photo-card__frame">{frameNo}</div>
				{title && <strong class="gallery-photo-card__title">{title}</strong>}
				{caption && <span class="gallery-photo-card__note">{caption}</span>}
			</figcaption>
		)
	}
</figure>

<style>
	.gallery-photo-card__media {
		position: relative;
		overflow: hidden;
		border-radius: 0.5rem;
		background: color-mix(in oklab, var(--btn-regular-bg) 60%, transparent);
	}

	.gallery-photo-card__caption {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		margin-top: 0.6rem;
		padding-inline: 0.15rem;
	}

	.gallery-photo-card__frame {
		align-self: flex-end;
		font-family: var(--font-mono, ui-monospace, monospace);
		font-size: 0.62rem;
		font-weight: 700;
		letter-spacing: 0.18em;
		color: #a98b4e;
	}

	.gallery-photo-card__title {
		font-size: 0.95rem;
		font-weight: 650;
		line-height: 1.3;
		color: var(--deep-text);
		transition: transform 0.3s ease, color 0.3s ease;
	}

	.gallery-photo-card__note {
		font-size: 0.78rem;
		line-height: 1.55;
		color: var(--content-meta);
	}

	.gallery-photo-card:hover .gallery-photo-card__title {
		transform: translateY(-1px);
		color: #a98b4e;
	}
</style>
