---
import type { Moment } from "@/data/moments";

interface Props {
	moment: Moment;
}

const { moment } = Astro.props;
---

<article class="glimmer-note">
	<div class="glimmer-note__meta">
		<time datetime={`${moment.year}-${moment.date.replace(".", "-")}`}>
			{moment.year} · {moment.date}
		</time>
		<span>{moment.type}</span>
	</div>
	<div class="glimmer-note__lines">
		{moment.lines.map((line) => <p>{line}</p>)}
	</div>
	{
		moment.image && (
			<figure class="glimmer-note__photo">
				<img
					src={moment.image.src}
					alt={moment.image.alt}
					loading="lazy"
					decoding="async"
				/>
			</figure>
		)
	}
</article>

<style>
	.glimmer-note {
		--note-tilt: -1.2deg;
		position: relative;
		min-height: 150px;
		overflow: visible;
		border: 1px solid rgba(244, 143, 177, 0.28);
		border-radius: 6px;
		background: var(--card-bg);
		padding: 22px 22px 20px;
		box-shadow: 0 12px 28px rgb(0 0 0 / 0.1);
		transform: rotate(var(--note-tilt));
		transition:
			transform 0.24s ease,
			box-shadow 0.24s ease;
	}

	.glimmer-note::before {
		content: "";
		position: absolute;
		left: 50%;
		top: -11px;
		width: 58px;
		height: 16px;
		transform: translateX(-50%) rotate(-2deg);
		border-radius: 3px;
		background: rgba(255, 183, 201, 0.5);
		box-shadow: 0 2px 6px rgb(255 183 201 / 0.16);
		pointer-events: none;
	}

	.glimmer-note:nth-child(2n) {
		--note-tilt: 1.3deg;
	}

	.glimmer-note:nth-child(3n) {
		--note-tilt: -0.7deg;
	}

	.glimmer-note:hover {
		transform: rotate(0deg) translateY(-6px);
		box-shadow: 0 18px 36px rgb(0 0 0 / 0.14);
	}

	.glimmer-note__meta {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 12px;
		margin-bottom: 12px;
	}

	.glimmer-note__meta time {
		color: var(--content-meta);
		font-size: 0.75rem;
		font-variant-numeric: tabular-nums;
	}

	.glimmer-note__meta span {
		color: rgb(244 143 177 / 0.9);
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.06em;
	}

	.glimmer-note__lines p {
		margin: 0;
		color: var(--deep-text);
		font-size: 0.92rem;
		line-height: 1.8;
	}

	.glimmer-note__lines p + p {
		margin-top: 6px;
	}

	.glimmer-note__photo {
		margin: 14px 0 0;
	}

	.glimmer-note__photo img {
		display: block;
		width: 100%;
		border-radius: 4px;
		object-fit: cover;
	}
</style>
