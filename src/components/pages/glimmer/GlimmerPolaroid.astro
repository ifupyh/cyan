---
interface Props {
	id: string;
	name: string;
	cover: string;
	photoCount?: number;
	href?: string;
}

const { id, name, cover, href } = Astro.props;
const link = href ?? `/gallery/${id}/`;
---

<a
	href={link}
	class="glimmer-polaroid group"
	aria-label={`打开${name}相册`}
>
	<div class="glimmer-polaroid__photo">
		{
			cover ? (
				<img src={cover} alt={name} loading="lazy" decoding="async" />
			) : (
				<div class="glimmer-polaroid__placeholder">&#x1f4f7;</div>
			)
		}
	</div>
	<span class="glimmer-polaroid__title">{name}</span>
</a>

<style>
	.glimmer-polaroid {
		--tilt: -1.2deg;
		position: relative;
		display: block;
		min-height: 150px;
		padding: 9px 9px 26px;
		transform: rotate(var(--tilt));
		border: 1px solid var(--line-divider);
		border-radius: 2px;
		background: var(--card-bg);
		box-shadow: 0 10px 22px rgb(0 0 0 / 0.08);
		color: inherit;
		text-decoration: none;
		transition:
			transform 0.24s ease,
			box-shadow 0.24s ease;
	}

	.glimmer-polaroid:nth-child(2n) {
		--tilt: 1.3deg;
	}

	.glimmer-polaroid:nth-child(3n) {
		--tilt: -0.6deg;
	}

	.glimmer-polaroid:hover,
	.glimmer-polaroid:focus-visible {
		transform: rotate(0deg) translateY(-4px);
		box-shadow: 0 14px 28px rgb(0 0 0 / 0.12);
	}

	.glimmer-polaroid__photo {
		overflow: hidden;
		border: 1px solid var(--line-divider);
	}

	.glimmer-polaroid__photo img {
		display: block;
		width: 100%;
		aspect-ratio: 1 / 1;
		object-fit: cover;
	}

	.glimmer-polaroid__placeholder {
		display: grid;
		aspect-ratio: 1 / 1;
		place-items: center;
		font-size: 2.5rem;
		color: var(--content-meta);
		background: color-mix(in oklab, var(--btn-regular-bg) 60%, transparent);
	}

	.glimmer-polaroid__title {
		position: absolute;
		right: 8px;
		bottom: 8px;
		left: 8px;
		overflow: hidden;
		color: var(--content-meta);
		font-size: 0.8rem;
		text-align: center;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
</style>
