---
// 文章列表分页组件（自定义 page 数据，适配 /posts/ + /posts/page/N/ 路径）
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";

interface Props {
	currentPage: number;
	totalPages: number;
	basePath: string; // 已处理 BASE_URL 的列表页基础路径，如 "/posts"
	class?: string;
}

const { currentPage, totalPages, basePath, class: className } = Astro.props;

const pageUrl = (p: number): string =>
	p <= 1 ? `${basePath}/` : `${basePath}/page/${p}/`;

const pages: number[] = [];
for (let i = 1; i <= totalPages; i++) pages.push(i);
---

<div
  class:list={[
    className,
    "post-list-pagination flex flex-wrap items-center justify-center gap-2 onload-animation",
  ]}
>
  <a
    href={currentPage > 1 ? pageUrl(currentPage - 1) : undefined}
    class:list={[
      "btn-card rounded-lg px-3 h-10 flex items-center text-sm",
      { "pointer-events-none opacity-40": currentPage <= 1 },
    ]}
    aria-disabled={currentPage <= 1 ? "true" : "false"}
  >
    {i18n(I18nKey.paginationPrev)}
  </a>

  {
    pages.map((p) =>
      p === currentPage ? (
        <span
          class="h-10 min-w-10 px-2 rounded-lg bg-(--primary) flex items-center justify-center font-bold text-white dark:text-black/70 text-sm"
          aria-current="page"
        >
          {p}
        </span>
      ) : (
        <a
          href={pageUrl(p)}
          class="btn-card h-10 min-w-10 px-2 rounded-lg flex items-center justify-center text-sm text-neutral-700 dark:text-neutral-300"
        >
          {p}
        </a>
      ),
    )
  }

  <a
    href={currentPage < totalPages ? pageUrl(currentPage + 1) : undefined}
    class:list={[
      "btn-card rounded-lg px-3 h-10 flex items-center text-sm",
      { "pointer-events-none opacity-40": currentPage >= totalPages },
    ]}
    aria-disabled={currentPage >= totalPages ? "true" : "false"}
  >
    {i18n(I18nKey.paginationNext)}
  </a>
</div>
