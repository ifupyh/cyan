import Layout from "@/layouts/Layout.astro";
import Navbar from "@/components/layout/Navbar.astro";
import MusicPlayerFullscreen from "@/components/features/MusicPlayerFullscreen.svelte";
---

<Layout title="音乐" description="褪色印记 · 赐福电台">
	<div class="nav-overlay">
		<Navbar />
	</div>
	<MusicPlayerFullscreen client:load />
</Layout>
