---
import { Icon } from "astro-icon/components";
import { getEnabledFriends, siteConfig } from "@/config";
import { formatDateToYYYYMMDD } from "@/utils/date-utils";
import { loadFriendsFeed } from "@/utils/friends-feed";
import CommunityBar from "@/components/layout/CommunityBar.astro";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

const friends = getEnabledFriends();
const feed = await loadFriendsFeed(friends);
const title = "朋友圈";
const description = "把友链博客最近写下的文章，收进一条轻盈的时间线。";

const normalizeFriendUrl = (url: string | undefined | null) =>
	(url ?? "")
		.trim()
		.replace(/^https?:\/\//i, "")
		.replace(/^www\./i, "")
		.replace(/\/+$/, "")
		.toLowerCase();
const ownSiteUrl = normalizeFriendUrl(siteConfig.site_url);
const friendsByUrl = new Map(
	friends
		.map((friend) => [normalizeFriendUrl(friend.siteurl), friend] as const)
		.filter(([url]) => url.length > 0),
);
const subscribedFriendUrls = new Set(
	feed.sources.map((source) => normalizeFriendUrl(source.friendUrl)),
);
const unsubscribedFriends = friends.filter(
	(friend) => !subscribedFriendUrls.has(normalizeFriendUrl(friend.siteurl)),
);
---

<MainGridLayout title={title} description={description}>
	<CommunityBar active="moments" />

	<section class="moments-shell card-base z-10 px-9 py-6 relative w-full onload-animation" aria-labelledby="moments-title">
		<header class="moments-header">
			<div class="moments-heading">
				<div class="moments-heading-icon" aria-hidden="true">
					<Icon is:inline name="material-symbols:rss-feed-rounded" />
				</div>
				<div>
					<h1 id="moments-title">朋友圈</h1>
					<p>来自友链站点的最近更新，偶尔路过，也别忘了留下你的脚印。</p>
				</div>
			</div>
			<div class="moments-stats" aria-label="朋友圈更新统计">
				<strong>{feed.items.length}</strong>
				<span>篇更新</span>
			</div>
			<div class="moments-note">
				<Icon is:inline name="material-symbols:auto-awesome-rounded" aria-hidden="true" />
				<span>
					显示 {feed.sources.length}/{feed.checkedCount} 个友链来源（最新 {feed.freshSources} 个，沿用快照 {feed.staleSources} 个）。
				</span>
			</div>
			{unsubscribedFriends.length > 0 && (
				<p class="moments-unsubscribed" role="status">
					<Icon is:inline name="material-symbols:info-outline-rounded" aria-hidden="true" />
					<span>
						未订阅的站点：{unsubscribedFriends.map((friend) => friend.title).join("、")}，如有需要，请与本站站长联系添加 RSS/Atom
					</span>
				</p>
			)}
		</header>

		{feed.items.length > 0 ? (
			<div class="moments-grid my-4" aria-label="友链文章更新">
				{feed.items.map((item) => {
					const isOwnSite = normalizeFriendUrl(item.friendUrl) === ownSiteUrl;
					const isRecommended = !isOwnSite && friendsByUrl.get(normalizeFriendUrl(item.friendUrl))?.recommended === true;

					return (
					<a
						href={item.link}
						target="_blank"
						rel="noopener noreferrer"
						class:list={[
							"moment-card group",
							isOwnSite && "moment-card--own",
							isRecommended && "moment-card--recommended",
						]}
						data-moment-card
						aria-label={`${item.title}，来自 ${item.friendTitle}`}
					>
						{(isOwnSite || isRecommended) && (
							<span
								class="moment-flow"
								data-moment-flow
								data-flow-tone={isRecommended ? "gold" : "blue"}
								aria-hidden="true"
							>
								<span class="moment-flow-silk"></span>
								<canvas class="moment-flow-stars"></canvas>
							</span>
						)}
						<div class="moment-avatar">
							<img src={item.avatar} alt="" width="48" height="48" loading="lazy" decoding="async" />
						</div>
						<div class="moment-content">
							<div class="moment-title-row">
								<h2>{item.title}</h2>
								<Icon is:inline name="material-symbols:arrow-outward-rounded" aria-hidden="true" />
							</div>
							<p class="moment-meta">
								<span>{item.friendTitle}</span>
								{isOwnSite && (
									<span class="moment-identity-badge moment-identity-badge--own">
										<Icon is:inline name="material-symbols:home-rounded" aria-hidden="true" />
										本站主理人
									</span>
								)}
								{isRecommended && (
									<span class="moment-identity-badge moment-identity-badge--recommended">
										<Icon is:inline name="material-symbols:star-rounded" aria-hidden="true" />
										推荐友链
									</span>
								)}
								<span aria-hidden="true">·</span>
								<time datetime={item.publishedAt?.toISOString()}>
									{item.publishedAt ? formatDateToYYYYMMDD(item.publishedAt) : "最近更新"}
								</time>
							</p>
							{item.description && <p class="moment-description">{item.description}</p>}
						</div>
					</a>
					);
				})}
			</div>
			<nav class="moments-pagination" data-moments-pagination aria-label="朋友圈分页">
				<button type="button" data-moments-page="prev" aria-label="上一页">
					<Icon is:inline name="material-symbols:chevron-left-rounded" aria-hidden="true" />
					<span>上一页</span>
				</button>
				<span data-moments-page-indicator aria-live="polite">第 1 / 1 页</span>
				<form class="moments-page-jump" data-moments-page-jump-form aria-label="跳转到朋友圈页">
					<label for="moments-page-jump-input">跳转至</label>
					<input
						id="moments-page-jump-input"
						data-moments-page-jump-input
						type="number"
						min="1"
						inputmode="numeric"
						aria-label="页码"
						placeholder="页码"
					/>
					<span aria-hidden="true">页</span>
					<button type="submit">前往</button>
				</form>
				<button type="button" data-moments-page="next" aria-label="下一页">
					<span>下一页</span>
					<Icon is:inline name="material-symbols:chevron-right-rounded" aria-hidden="true" />
				</button>
			</nav>
		) : (
			<div class="moments-empty card-base">
				<Icon is:inline name="material-symbols:rss-feed-rounded" aria-hidden="true" />
				<h2>暂时还没有读到更新</h2>
				<p>友链站点可能暂未提供 RSS / Atom，下一次构建时会再次尝试探测。</p>
			</div>
		)}
	</section>

<script is:inline>
	(() => {
		const runtimeKey = "__cyanMomentsRuntime";
		const runtime = window[runtimeKey] || {
			activeShell: null,
			cleanup: null,
			init: null,
			eventsBound: false,
			hooksBound: false,
			scheduledFrame: 0,
		};

		const clearActiveRuntime = () => {
			if (typeof runtime.cleanup === "function") runtime.cleanup();
			runtime.cleanup = null;
			runtime.activeShell = null;
		};

		const initMomentsPage = () => {
			const shell = document.querySelector(".moments-shell");
			if (!shell) {
				clearActiveRuntime();
				return;
			}
			if (runtime.activeShell === shell) return;

			clearActiveRuntime();
			runtime.activeShell = shell;
			const cleanups = [];
			runtime.cleanup = () => {
				for (const cleanup of cleanups.splice(0)) cleanup();
				runtime.activeShell = null;
			};

			const momentsPageSize = 20;
			const momentsCards = Array.from(shell.querySelectorAll("[data-moment-card]"));
			const momentsPagination = shell.querySelector("[data-moments-pagination]");

			if (momentsCards.length > 0 && momentsPagination) {
				const momentsIndicator = momentsPagination.querySelector("[data-moments-page-indicator]");
				const momentsPrev = momentsPagination.querySelector("[data-moments-page='prev']");
				const momentsNext = momentsPagination.querySelector("[data-moments-page='next']");
				const momentsJumpForm = momentsPagination.querySelector("[data-moments-page-jump-form]");
				const momentsJumpInput = momentsPagination.querySelector("[data-moments-page-jump-input]");
				const momentsTotalPages = Math.max(1, Math.ceil(momentsCards.length / momentsPageSize));
				const getMomentsPage = () => {
					const value = Number.parseInt(new URL(window.location.href).searchParams.get("page") || "1", 10);
					return Number.isFinite(value) && value > 0 ? Math.min(value, momentsTotalPages) : 1;
				};
				let momentsCurrentPage = getMomentsPage();

				const updateMomentsUrl = () => {
					const nextUrl = new URL(window.location.href);
					if (momentsCurrentPage === 1) nextUrl.searchParams.delete("page");
					else nextUrl.searchParams.set("page", String(momentsCurrentPage));
					window.history.pushState(null, "", `${nextUrl.pathname}${nextUrl.search}${nextUrl.hash}`);
				};

				const renderMomentsPage = () => {
					const start = (momentsCurrentPage - 1) * momentsPageSize;
					momentsCards.forEach((card, index) => {
						card.hidden = index < start || index >= start + momentsPageSize;
					});
					momentsPagination.classList.toggle("is-visible", momentsTotalPages > 1);
					if (momentsIndicator) {
						momentsIndicator.textContent = `第 ${momentsCurrentPage} / ${momentsTotalPages} 页 · 共 ${momentsCards.length} 篇`;
					}
					if (momentsJumpInput instanceof HTMLInputElement) {
						momentsJumpInput.max = String(momentsTotalPages);
						momentsJumpInput.placeholder = String(momentsCurrentPage);
						momentsJumpInput.setAttribute("aria-valuemax", String(momentsTotalPages));
						momentsJumpInput.setAttribute("aria-valuenow", String(momentsCurrentPage));
					}
					if (momentsPrev) {
						momentsPrev.disabled = momentsCurrentPage === 1;
						momentsPrev.setAttribute("aria-disabled", String(momentsPrev.disabled));
					}
					if (momentsNext) {
						momentsNext.disabled = momentsCurrentPage === momentsTotalPages;
						momentsNext.setAttribute("aria-disabled", String(momentsNext.disabled));
					}
				};

				const goToMomentsPage = (page) => {
					momentsCurrentPage = Math.min(Math.max(page, 1), momentsTotalPages);
					updateMomentsUrl();
					renderMomentsPage();
					shell.querySelector(".moments-header")?.scrollIntoView({ behavior: "smooth", block: "start" });
				};

				const handlePaginationClick = (event) => {
					const button = event.target instanceof Element
						? event.target.closest("button[data-moments-page]")
						: null;
					if (!button || button.disabled) return;
					goToMomentsPage(momentsCurrentPage + (button.dataset.momentsPage === "next" ? 1 : -1));
				};
				const handleJumpSubmit = (event) => {
					event.preventDefault();
					if (!(momentsJumpInput instanceof HTMLInputElement)) return;
					const value = Number.parseInt(momentsJumpInput.value, 10);
					if (!Number.isFinite(value)) {
						momentsJumpInput.focus();
						return;
					}
					momentsJumpInput.value = "";
					goToMomentsPage(value);
				};
				const handlePopState = () => {
					momentsCurrentPage = getMomentsPage();
					renderMomentsPage();
				};

				momentsPagination.addEventListener("click", handlePaginationClick);
				momentsJumpForm?.addEventListener("submit", handleJumpSubmit);
				window.addEventListener("popstate", handlePopState);
				cleanups.push(() => {
					momentsPagination.removeEventListener("click", handlePaginationClick);
					momentsJumpForm?.removeEventListener("submit", handleJumpSubmit);
					window.removeEventListener("popstate", handlePopState);
				});

				renderMomentsPage();
			}

			const momentFlowHosts = Array.from(shell.querySelectorAll("[data-moment-flow]"));
			const momentFlowReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

			for (const host of momentFlowHosts) {
				const canvas = host.querySelector(".moment-flow-stars");
				const context = canvas instanceof HTMLCanvasElement ? canvas.getContext("2d") : null;
				if (!(canvas instanceof HTMLCanvasElement) || !context) continue;

				let dpr = Math.min(window.devicePixelRatio || 1, 2);
				let width = 0;
				let height = 0;
				let particles = [];
				let last = performance.now();
				let animationFrame = 0;
				let resizeObserver = null;
				let stopped = false;
				const particleCount = 32;
				const tone = host.dataset.flowTone === "gold"
					? { core: "255,176,0", glow: "255,225,92" }
					: { core: "32,143,232", glow: "151,220,255" };

				const drawRoundedStar = (x, y, outerRadius, innerRadius, rotation) => {
					const points = Array.from({ length: 10 }, (_, index) => {
						const angle = rotation + (Math.PI * index) / 5;
						const radius = index % 2 === 0 ? outerRadius : innerRadius;
						return { x: x + Math.cos(angle) * radius, y: y + Math.sin(angle) * radius };
					});
					context.beginPath();
					for (let index = 0; index < points.length; index += 1) {
						const previous = points[(index + points.length - 1) % points.length];
						const current = points[index];
						const next = points[(index + 1) % points.length];
						const startX = (previous.x + current.x) / 2;
						const startY = (previous.y + current.y) / 2;
						const endX = (current.x + next.x) / 2;
						const endY = (current.y + next.y) / 2;
						if (index === 0) context.moveTo(startX, startY);
						context.quadraticCurveTo(current.x, current.y, endX, endY);
					}
					context.closePath();
					context.fill();
				};

				const createParticle = () => ({
					x: Math.random() * Math.max(width - 20, 1),
					y: 4 + Math.random() * Math.max(height - 8, 1),
					r: Math.random() < 0.26 ? 2.2 + Math.random() * 1.2 : 1.15 + Math.random() * 1.15,
					speed: 0.08 + Math.random() * 0.2,
					alpha: 0.26 + Math.random() * 0.44,
					pulse: Math.random() * Math.PI * 2,
					pulseSpeed: 0.012 + Math.random() * 0.02,
					rotation: -Math.PI / 2 + (Math.random() - 0.5) * 0.2,
					streak: Math.random() < 0.1,
				});

				const resize = () => {
					if (stopped || !host.isConnected) return;
					const rect = host.getBoundingClientRect();
					width = rect.width;
					height = rect.height;
					if (!width || !height) return;
					dpr = Math.min(window.devicePixelRatio || 1, 2);
					canvas.width = Math.round(width * dpr);
					canvas.height = Math.round(height * dpr);
					canvas.style.width = `${width}px`;
					canvas.style.height = `${height}px`;
					context.setTransform(dpr, 0, 0, dpr, 0, 0);
					particles = Array.from({ length: particleCount }, createParticle);
				};

				const draw = (now) => {
					if (stopped || !host.isConnected) return;
					if (!width || !height) {
						if (!momentFlowReducedMotion) animationFrame = requestAnimationFrame(draw);
						return;
					}
					const dt = Math.min(32, now - last);
					last = now;
					context.clearRect(0, 0, width, height);
					const endX = width - 5;

					for (const particle of particles) {
						if (!momentFlowReducedMotion) particle.x += particle.speed * dt;
						if (particle.x > endX) {
							particle.x = -4 - Math.random() * 24;
							particle.y = 4 + Math.random() * Math.max(height - 8, 1);
						}
						if (!momentFlowReducedMotion) particle.pulse += particle.pulseSpeed * dt;

						const twinkle = 0.68 + 0.32 * Math.sin(particle.pulse);
						const alpha = particle.alpha * twinkle;

						if (particle.streak) {
							const streak = context.createLinearGradient(particle.x - 8, particle.y, particle.x + 2, particle.y);
							streak.addColorStop(0, `rgba(${tone.core},0)`);
							streak.addColorStop(1, `rgba(${tone.core},${alpha * 0.7})`);
							context.strokeStyle = streak;
							context.lineWidth = 0.8;
							context.beginPath();
							context.moveTo(particle.x - 8, particle.y);
							context.lineTo(particle.x + 1, particle.y);
							context.stroke();
						}

						const glow = context.createRadialGradient(
							particle.x,
							particle.y,
							0,
							particle.x,
							particle.y,
							particle.r * 5.2,
						);
						glow.addColorStop(0, `rgba(${tone.core},${Math.min(1, alpha)})`);
						glow.addColorStop(0.26, `rgba(${tone.glow},${alpha * 0.72})`);
						glow.addColorStop(1, `rgba(${tone.core},0)`);
						context.fillStyle = glow;
						context.beginPath();
						context.arc(particle.x, particle.y, particle.r * 5.2, 0, Math.PI * 2);
						context.fill();

						context.fillStyle = `rgba(${tone.core},${Math.min(1, alpha + 0.18)})`;
						drawRoundedStar(
							particle.x,
							particle.y,
							particle.r * 1.35,
							particle.r * 0.58,
							particle.rotation,
						);
					}

					if (!momentFlowReducedMotion) animationFrame = requestAnimationFrame(draw);
				};

				const stop = () => {
					stopped = true;
					if (animationFrame) cancelAnimationFrame(animationFrame);
					resizeObserver?.disconnect();
					window.removeEventListener("resize", resize);
				};

				resize();
				if ("ResizeObserver" in window) {
					resizeObserver = new ResizeObserver(resize);
					resizeObserver.observe(host);
				}
				window.addEventListener("resize", resize, { passive: true });
				animationFrame = requestAnimationFrame(draw);
				cleanups.push(stop);
			}
		};

		const scheduleMomentsInit = () => {
			if (runtime.scheduledFrame) cancelAnimationFrame(runtime.scheduledFrame);
			runtime.scheduledFrame = requestAnimationFrame(() => {
				runtime.scheduledFrame = 0;
				runtime.init?.();
			});
		};
		const bindSwupHooks = () => {
			if (runtime.hooksBound || !window.swup?.hooks) return;
			window.swup.hooks.on("content:replace", scheduleMomentsInit);
			window.swup.hooks.on("page:view", scheduleMomentsInit);
			runtime.hooksBound = true;
		};

		runtime.init = initMomentsPage;
		window[runtimeKey] = runtime;
		if (!runtime.eventsBound) {
			for (const eventName of [
				"astro:page-load",
				"swup:contentReplaced",
				"swup:content:replace",
				"swup:page:view",
			]) {
				document.addEventListener(eventName, scheduleMomentsInit);
			}
			document.addEventListener("swup:enable", bindSwupHooks);
			runtime.eventsBound = true;
		}
		bindSwupHooks();
		initMomentsPage();
	})();
</script>
</MainGridLayout>

<style>
	.moments-shell {
		display: block;
		background: var(--card-bg);
	}

	.moments-header {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: 1.25rem 2rem;
		padding: 0;
		overflow: hidden;
		background: transparent;
		box-shadow: none;
	}

	.moments-header::after {
		content: "";
		position: absolute;
		right: 1.25rem;
		bottom: -3.5rem;
		width: 10rem;
		height: 10rem;
		border: 1px solid color-mix(in srgb, var(--primary) 16%, transparent);
		border-radius: 50%;
		pointer-events: none;
	}

	.moments-heading {
		display: flex;
		align-items: center;
		gap: 0.85rem;
		min-width: 0;
	}

	.moments-heading-icon {
		display: grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		flex: 0 0 auto;
		border-radius: 0.85rem;
		color: white;
		background: var(--primary);
		box-shadow: 0 0.7rem 1.6rem color-mix(in srgb, var(--primary) 22%, transparent);
		font-size: 1.45rem;
	}

	.moments-heading h1 {
		margin: 0;
		font-size: clamp(1.35rem, 3vw, 1.85rem);
		font-weight: 800;
		letter-spacing: -0.02em;
		color: var(--content-meta);
	}

	.moments-heading p {
		margin: 0.3rem 0 0;
		color: var(--content-meta);
		font-size: 0.9rem;
		line-height: 1.6;
	}

	.moments-stats {
		position: relative;
		z-index: 1;
		display: flex;
		align-items: baseline;
		gap: 0.4rem;
		align-self: center;
		white-space: nowrap;
		color: var(--content-meta);
	}

	.moments-stats strong {
		color: var(--primary);
		font-size: 1.55rem;
		font-variant-numeric: tabular-nums;
	}

	.moments-stats span {
		font-size: 0.8rem;
	}

	.moments-note {
		display: flex;
		grid-column: 1 / -1;
		align-items: center;
		gap: 0.45rem;
		padding-top: 0.8rem;
		border-top: 1px solid var(--line-divider);
		color: var(--text-color);
		font-size: 0.76rem;
		line-height: 1.55;
	}

	.moments-note svg {
		flex: 0 0 auto;
		color: var(--primary);
	}

	.moments-unsubscribed {
		display: flex;
		grid-column: 1 / -1;
		align-items: flex-start;
		gap: 0.45rem;
		margin: -0.55rem 0 0;
		padding: 0.55rem 0.7rem;
		border: 1px solid color-mix(in srgb, var(--primary) 18%, var(--line-divider));
		border-radius: 0.65rem;
		background: color-mix(in srgb, var(--primary) 5%, var(--card-bg));
		color: var(--content-meta);
		font-size: 0.74rem;
		line-height: 1.55;
	}

	.moments-unsubscribed svg {
		flex: 0 0 auto;
		margin-top: 0.12rem;
		color: var(--primary);
	}


	.moments-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.75rem;
	}

	.moments-pagination {
		display: none;
		align-items: center;
		justify-content: center;
		gap: 0.75rem;
		margin-top: 0.25rem;
	}

	.moments-pagination.is-visible {
		display: flex;
	}

	.moments-pagination button,
	.moments-pagination > span {
		display: inline-flex;
		min-height: 2.25rem;
		align-items: center;
		justify-content: center;
		gap: 0.25rem;
		border: 1px solid color-mix(in srgb, var(--primary) 18%, var(--line-divider));
		border-radius: 0.75rem;
		background: color-mix(in srgb, var(--card-bg) 90%, transparent);
		color: var(--content-meta);
		font-size: 0.8rem;
		line-height: 1;
	}

	.moments-pagination button {
		padding: 0.55rem 0.75rem;
		cursor: pointer;
		transition: border-color 180ms ease, background-color 180ms ease, color 180ms ease, opacity 180ms ease;
	}

