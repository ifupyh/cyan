---
import { Icon } from "astro-icon/components";
import InterviewQuestionList from "@/components/pages/interview/InterviewQuestionList.svelte";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import {
	getInterviewCategories,
	getInterviewCategory,
	getQuestionsByCategory,
} from "@/utils/interview-utils";
import { url } from "@/utils/url-utils";

export async function getStaticPaths() {
	const categories = await getInterviewCategories();
	return categories.map((c) => ({ params: { category: c.slug } }));
}

const { category } = Astro.params;
const cat = getInterviewCategory(category ?? "");
const questions = await getQuestionsByCategory(category ?? "");
---

<MainGridLayout title={cat?.name ?? category ?? "面试题库"}>
  <div class="mb-6">
    <a
      href={url("/interview/")}
      class="inline-flex items-center gap-1 text-sm text-(--primary) hover:underline mb-3"
    >
      <Icon is:inline name="material-symbols:arrow-back" class="text-base" />
      返回题库
    </a>
    <div class="flex items-baseline gap-3">
      <h1
        class="text-3xl md:text-4xl font-medium tracking-tight text-black/85 dark:text-white/85 leading-tight"
      >
        {cat?.name ?? category}
      </h1>
      <span class="text-sm text-black/45 dark:text-white/45">{questions.length} 题</span>
    </div>
  </div>

  <InterviewQuestionList client:load category={category ?? ""} questions={questions} />
</MainGridLayout>
