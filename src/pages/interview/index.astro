---
import { Icon } from "astro-icon/components";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { getInterviewCategories } from "@/utils/interview-utils";
import { url } from "@/utils/url-utils";

const categories = await getInterviewCategories();
---

<MainGridLayout
  title="面试题库"
  description="嵌入式 / C / C++ / Linux 面试题，按分类浏览，逐题拆解。"
>
  <div class="mb-8">
    <a
      href={url("/glimmer/")}
      class="inline-flex items-center gap-1 text-sm text-(--primary) hover:underline mb-3"
    >
      <Icon is:inline name="material-symbols:arrow-back" class="text-base" />
      返回浮光集
    </a>
    <h1
      class="text-3xl md:text-4xl font-medium tracking-tight text-black/85 dark:text-white/85 leading-tight"
    >
      面试题库
    </h1>
    <p class="mt-3 text-base text-black/55 dark:text-white/55 leading-relaxed max-w-xl">
      嵌入式 / C / C++ / Linux 面试题，按分类浏览，逐题拆解。
    </p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    {categories.map((cat) => (
      <a
        href={url(`/interview/${cat.slug}/`)}
        class="card-base p-6 flex flex-col gap-4 group hover:-translate-y-1 hover:border-(--primary) transition-all"
      >
        <div
          class="w-12 h-12 rounded-lg bg-(--primary)/10 group-hover:bg-(--primary)/20 flex items-center justify-center transition-colors"
        >
          <Icon is:inline name={cat.icon} class="text-2xl text-(--primary)" />
        </div>
        <div>
          <h2
            class="text-base font-semibold text-black/85 dark:text-white/85 group-hover:text-(--primary) transition-colors"
          >
            {cat.name}
          </h2>
          <p class="text-sm text-black/45 dark:text-white/45 mt-1">{cat.count} 题</p>
        </div>
      </a>
    ))}
  </div>
</MainGridLayout>
