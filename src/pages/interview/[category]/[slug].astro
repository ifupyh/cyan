---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import Markdown from "@/components/common/Markdown.astro";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { DIFFICULTY_LABELS } from "@/types/interview";
import {
	getAdjacentQuestions,
	getInterviewCategory,
	getQuestionSlug,
} from "@/utils/interview-utils";
import { url } from "@/utils/url-utils";

export async function getStaticPaths() {
	const questions = await getCollection("interview");
	return questions.map((entry) => {
		const slug = getQuestionSlug(entry);
		return {
			params: { category: entry.data.category, slug },
			props: { entry },
		};
	});
}

const { entry } = Astro.props as { entry: CollectionEntry<"interview"> };
const { category, slug } = Astro.params;
const { Content } = await render(entry);

const cat = getInterviewCategory(category ?? "");
const { prev, next } = await getAdjacentQuestions(category ?? "", slug ?? "");

const difficultyClass: Record<string, string> = {
	easy: "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400",
	medium: "bg-amber-500/10 text-amber-600 dark:text-amber-400",
	hard: "bg-rose-500/10 text-rose-600 dark:text-rose-400",
};
---

<MainGridLayout title={entry.data.title} description={entry.data.title}>
  <div class="mb-6">
    <a
      href={url(`/interview/${category}/`)}
      class="inline-flex items-center gap-1 text-sm text-(--primary) hover:underline"
    >
      <Icon is:inline name="material-symbols:arrow-back" class="text-base" />
      返回分类
    </a>

    <h1
      class="text-2xl md:text-3xl font-bold tracking-tight text-black/90 dark:text-white/90 leading-tight mt-4"
    >
      {entry.data.title}
    </h1>

    <div class="flex items-center justify-between gap-4 mt-4">
      <div class="flex items-center gap-3">
        {prev ? (
          <a
            href={url(`/interview/${category}/${prev.slug}/`)}
            class="inline-flex items-center gap-1 text-sm text-(--primary) hover:underline"
          >
            <Icon is:inline name="material-symbols:arrow-back" class="text-base" />
            上一题
          </a>
        ) : (
          <span />
        )}
        <span
          class="text-xs font-medium px-2 py-0.5 rounded whitespace-nowrap {difficultyClass[entry.data.difficulty]}"
        >
          {DIFFICULTY_LABELS[entry.data.difficulty]}
        </span>
      </div>
      {next ? (
        <a
          href={url(`/interview/${category}/${next.slug}/`)}
          class="inline-flex items-center gap-1 text-sm text-(--primary) hover:underline"
        >
          下一题
          <Icon is:inline name="material-symbols:arrow-forward" class="text-base" />
        </a>
      ) : (
        <span />
      )}
    </div>
  </div>

  <div class="card-base px-6 md:px-9 py-6 md:py-8 mb-4">
    <Markdown class="markdown-content">
      <Content />
    </Markdown>
  </div>
</MainGridLayout>

<style is:global>
  .answer-section {
    margin-top: 1.75rem;
    border: 1px solid var(--line-divider);
    border-radius: 0.75rem;
    overflow: hidden;
  }

  .answer-section summary {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.9rem 1.25rem;
    color: var(--primary);
    font-weight: 600;
    cursor: pointer;
    list-style: none;
    user-select: none;
    transition: background-color 0.2s ease;
  }

  .answer-section summary:hover {
    background: color-mix(in srgb, var(--primary) 8%, transparent);
  }

  .answer-section summary::-webkit-details-marker {
    display: none;
  }

  .answer-section summary::before {
    content: "▸";
    transition: transform 0.2s ease;
  }

  .answer-section[open] summary::before {
    transform: rotate(90deg);
  }

  .answer-section .answer-body {
    padding: 0 1.25rem 1.25rem;
    border-top: 1px dashed var(--line-divider);
  }
</style>
