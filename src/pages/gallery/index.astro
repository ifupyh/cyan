---
import { Icon } from "astro-icon/components";
import GlimmerPolaroid from "@/components/pages/glimmer/GlimmerPolaroid.astro";
import { galleryConfig, siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { getAlbumCover, scanAlbumPhotos } from "@/utils/gallery-utils";
import { url } from "@/utils/url-utils";

// 检查页面是否启用
if (!siteConfig.pages.gallery) {
	return Astro.redirect("/404/");
}

const title = i18n(I18nKey.gallery);
const description = i18n(I18nKey.galleryDescription);

// 构建相册数据（扫描照片、获取封面）
const albums = galleryConfig.albums.map((album) => {
	const photos = scanAlbumPhotos(album.id);
	const cover = getAlbumCover(album, photos);
	return { ...album, cover, photoCount: photos.length };
});

// 按标签分组：每个标签一个容器，容器里是该标签的相册
const tagMap = new Map<string, typeof albums>();
for (const album of albums) {
	for (const tag of album.tags || []) {
		if (!tagMap.has(tag)) tagMap.set(tag, []);
		tagMap.get(tag)!.push(album);
	}
}
const tagGroups = [...tagMap.entries()].map(([tag, items]) => ({ tag, items }));
---

<MainGridLayout title={title} description={description}>
	<!-- 返回 + 标题 + 标语 -->
	<div class="mb-8 md:mb-10">
		<a
			href={url("/glimmer/")}
			class="inline-flex items-center gap-1 text-sm text-(--primary) hover:underline mb-4"
		>
			<Icon is:inline name="material-symbols:arrow-back" class="text-base" />
			返回浮光集
		</a>
		<h1 class="text-4xl md:text-5xl font-medium tracking-tight text-black/85 dark:text-white/85 leading-tight">
			{title}
		</h1>
		{
			description && (
				<p class="mt-3 text-base text-black/55 dark:text-white/55 leading-relaxed max-w-xl">
					{description}
				</p>
			)
		}
	</div>

	<!-- 每个标签一个容器，容器里是该标签的相册封面 -->
	{
		tagGroups.map((group) => (
			<section class="card-base-transparent px-5 py-5 md:px-7 md:py-6 mb-8" data-album-group>
				<div class="flex items-baseline gap-3 mb-5">
					<h2 class="text-xl font-semibold text-black/85 dark:text-white/85">
						{group.tag}
					</h2>
					<span class="text-[0.7rem] text-black/40 dark:text-white/40 uppercase tracking-[0.18em]">
						{group.items.length}
					</span>
				</div>
				<div class="album-polaroid-grid" data-grid>
					{group.items.map((album) => (
						<GlimmerPolaroid
							id={album.id}
							name={album.name}
							cover={album.cover}
							photoCount={album.photoCount}
						/>
					))}
				</div>
				<button type="button" class="album-expand-btn" data-expand hidden>
					全部展开
				</button>
			</section>
		))
	}
</MainGridLayout>

<style>
	.album-polaroid-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, 118px);
		justify-content: start;
		gap: 1.5rem 1.25rem;
	}

	.album-expand-btn {
		display: block;
		margin: 0.75rem auto 0;
		padding: 0.4rem 1rem;
		border: 1px solid var(--line-divider);
		border-radius: 999px;
		background: transparent;
		color: var(--btn-content);
		font-size: 0.8rem;
		cursor: pointer;
		transition: color 0.2s ease, border-color 0.2s ease;
	}

	.album-expand-btn:hover {
		color: var(--primary);
		border-color: var(--primary);
	}

	@media (max-width: 640px) {
		.album-polaroid-grid {
			grid-template-columns: repeat(auto-fill, 108px);
			gap: 1.25rem 1rem;
		}
	}
</style>

<script>
	// 每个标签容器默认只展示约两行卡片，超过两行时显示「全部展开」
	function setupAlbumExpand() {
		document
			.querySelectorAll<HTMLElement>("[data-album-group]")
			.forEach((section) => {
				const grid = section.querySelector<HTMLElement>("[data-grid]");
				const btn = section.querySelector<HTMLElement>("[data-expand]");
				if (!grid || !btn) return;

				const cards = grid.children;
				if (cards.length === 0) return;

				const cardHeight = (cards[0] as HTMLElement).offsetHeight;
				const rowGap = parseFloat(getComputedStyle(grid).rowGap) || 0;
				const twoRowsHeight = cardHeight * 2 + rowGap;

				if (grid.scrollHeight <= twoRowsHeight + 5) {
					btn.hidden = true;
					return;
				}

				grid.style.maxHeight = `${twoRowsHeight}px`;
				grid.style.overflow = "hidden";
				btn.hidden = false;
				let expanded = false;
				btn.addEventListener("click", () => {
					expanded = !expanded;
					if (expanded) {
						grid.style.maxHeight = "none";
						grid.style.overflow = "visible";
						btn.textContent = "收起";
					} else {
						grid.style.maxHeight = `${twoRowsHeight}px`;
						grid.style.overflow = "hidden";
						btn.textContent = "全部展开";
					}
				});
			});
	}

	document.addEventListener("astro:page-load", setupAlbumExpand);
	setupAlbumExpand();
</script>
