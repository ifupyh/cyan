---
/**
 * 关于我页面
 *
 * ⚠️ 结构说明（重要，勿误改）：
 * 保留 MainGridLayout（导航栏、壁纸背景、AboutBar 位置不变），内容区用「文档流 CSS grid」
 * 实现悬浮玻璃拟态布局，不用负 margin / 绝对定位（避免被 MainGridLayout 的动画 transform
 * 与 absolute 主容器裁切或错位）。
 *
 * 布局分区（对照设计图）：
 *   ┌────────┬──────────────────┬──────────┐
 *   │ 头像   │ 标题+搜索+说说    │ 时钟面板 │
 *   │ 标签面板│                  │          │
 *   │ 统计图 │ 部署项目 / PROJECTS          │
 *   │ 社交   │ 项目卡片 ×4                 │
 *   └────────┴──────────────────┴──────────┘
 *
 * 数据来源：
 *   - 头像 / 名字 / 社交链接 → src/config/profileConfig.ts
 *   - 左侧「个人标签」→ 本文件 personalTags 数组（自定义）
 *   - 圆形统计图 → 文章分类（getCategoryList）
 *   - 「说说」→ TypewriterSayings.svelte 的 sayings 数组
 *   - 项目卡片 → 本文件 placeholderProjects（封面暂时空着）
 *
 * 玻璃拟态：通过 .about-page 局部 CSS 变量统一浅色文字，配合深色半透明 +
 * backdrop-filter 模糊，露出底层壁纸（壁纸跟随全局设置）。
 */
import { Icon } from "astro-icon/components";
import ImageWrapper from "@/components/common/ImageWrapper.astro";
import Search from "@/components/controls/Search.svelte";
import TypewriterSayings from "@/components/features/TypewriterSayings.svelte";
import AboutClock from "@/components/features/AboutClock.svelte";
import CategoryDonut from "@/components/features/CategoryDonut.svelte";
import AboutBar from "@/components/layout/AboutBar.astro";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { profileConfig } from "@/config";
import { getCategoryList } from "@/utils/content-utils";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";

// 自定义个人标签（左侧标签面板），改这里即可
const personalTags = [
	"TypeScript",
	"Astro",
	"AI 工程化",
	"跨境电商",
	"开源",
	"效率工具",
	"写作",
];

// 圆形统计图：文章分类（本地数据）
const categories = await getCategoryList();

// 项目卡片占位：封面暂时空着（不加图），后续替换为真实项目
const placeholderProjects = Array.from({ length: 8 }, (_, i) => ({
	title: `项目 ${i + 1}`,
	description: "这里是项目描述占位，后续替换为真实内容。",
}));
---

<MainGridLayout title={i18n(I18nKey.about)} description={i18n(I18nKey.about)}>
	<AboutBar active="about" />
	<div class="about-page">
		<!-- 左上：圆形头像 -->
		<div class="about-avatar">
			<ImageWrapper
				src={profileConfig.avatar || ""}
				alt={profileConfig.name}
				widths={[320]}
				sizes="10rem"
				loading="eager"
			/>
		</div>

		<!-- 中央：问候 + 搜索 + 说说 -->
		<header class="about-hero">
			<h1 class="about-greeting">
				嗨！我是 <span class="about-greeting__name">{profileConfig.name}</span>
			</h1>
			<div class="about-search"><Search client:load /></div>
			<div class="about-sayings"><TypewriterSayings client:load /></div>
		</header>

		<!-- 右上：时钟面板 -->
		<aside class="about-clock-panel glass">
			<AboutClock client:load />
		</aside>

		<!-- 左中：个人标签 -->
		<section class="about-tags-panel glass">
			<h2 class="about-panel__title">个人标签</h2>
			<div class="about-tags">
				{personalTags.map((t) => <span class="about-tag">{t}</span>)}
			</div>
		</section>

		<!-- 左下：圆形统计图 + 社交图标 -->
		<section class="about-stats">
			<div class="about-donut"><CategoryDonut client:load categories={categories} /></div>
			<div class="about-social">
				{profileConfig.links.map((link) => {
					const isCopy = link.url.startsWith("copy:");
					const isMail = link.url.startsWith("mailto:");
					const copyValue = isCopy ? link.url.replace("copy:", "") : "";
					if (isCopy) {
						return (
							<a
								href="javascript:void(0)"
								class="about-social__link"
								title={link.name}
								aria-label={link.name}
								data-copy={copyValue}
								onclick={`(function(e){e.preventDefault();var v=this.getAttribute('data-copy');if(v&&navigator.clipboard&&navigator.clipboard.writeText){navigator.clipboard.writeText(v);this.setAttribute('title','已复制');var self=this;setTimeout(function(){self.setAttribute('title','${link.name}')},1200)}})(event)`}
							>
								<Icon name={link.icon} />
							</a>
						);
					}
					if (isMail) {
						return (
							<a
								href={link.url}
								class="about-social__link"
								title={link.name}
								aria-label={link.name}
							>
								<Icon name={link.icon} />
							</a>
						);
					}
					return (
						<a
							href={link.url}
							target="_blank"
							rel="noopener noreferrer"
							class="about-social__link"
							title={link.name}
							aria-label={link.name}
						>
							<Icon name={link.icon} />
						</a>
					);
				})}
			</div>
		</section>

		<!-- 右下：横向项目卡片带 -->
		<main class="about-projects">
			<h2 class="about-projects__title">
				部署项目 <span class="about-projects__title-en">/ PROJECTS</span>
			</h2>
			<div class="about-projects__grid">
				{placeholderProjects.map((p) => (
					<article class="project-card glass">
						<div class="project-card__cover"></div>
						<div class="project-card__body">
							<h3 class="project-card__title">{p.title}</h3>
							<p class="project-card__desc">{p.description}</p>
							<a class="project-card__link" href="/about/">
								前往 <span aria-hidden="true">⌄</span>
							</a>
						</div>
					</article>
				))}
			</div>
		</main>
	</div>
</MainGridLayout>

<style>
	/* ===== 文档流 grid：左栏 / 中央 / 右时钟 ===== */
	.about-page {
		display: grid;
		grid-template-columns: clamp(280px, 18vw, 340px) minmax(0, 1fr) clamp(320px, 20vw, 380px);
		grid-template-areas:
			"avatar  hero  clock"
			"tags    hero  clock"
			"stats   projects projects";
		column-gap: 1.5rem;
		row-gap: 1.5rem;
		align-items: start;
		padding-bottom: 3rem;
	}

	/* 玻璃拟态基础：背景/文字跟随主题（亮色=白玻璃深字，暗色=深玻璃浅字），
	   透明度跟随「卡片透明度」变量（cardOpacity） */
	.glass {
		background: var(--card-bg-transparent);
		backdrop-filter: blur(32px) saturate(1.25);
		-webkit-backdrop-filter: blur(32px) saturate(1.25);
		border: 1px solid var(--line-divider);
		border-radius: 1rem;
		box-shadow: 0 10px 34px rgb(0 0 0 / 0.1);
	}

	/* ===== 左上：圆形头像 ===== */
	.about-avatar {
		grid-area: avatar;
		margin-left: 3rem;
		width: clamp(120px, 8vw, 160px);
		height: clamp(120px, 8vw, 160px);
		border-radius: 50%;
		overflow: hidden;
		border: 2px solid rgb(255 255 255 / 0.35);
		box-shadow: 0 8px 30px rgb(0 0 0 / 0.25);
	}

	.about-avatar :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	/* ===== 中央：问候 + 搜索 + 说说 ===== */
	.about-hero {
		grid-area: hero;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 1.1rem;
		min-width: 0;
		padding-top: 0.5rem;
	}

	.about-greeting {
		margin: 0;
		font-size: clamp(1.7rem, 3vw, 2.5rem);
		font-weight: 800;
		letter-spacing: -0.02em;
		color: var(--text-color);
	}

	.about-greeting__name {
		color: var(--primary);
	}

	/* 搜索框：占满中央列，深色玻璃 */
	.about-search {
		position: relative;
		width: 100%;
		max-width: 44rem;
	}

	.about-search :global(#search-switch) {
		display: none !important;
	}

	.about-search :global(#search-bar) {
		display: flex !important;
		width: 100% !important;
		background: var(--card-bg-transparent) !important;
		border: 1px solid var(--line-divider);
		border-radius: 0.9rem;
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
	}

	.about-search :global(#search-bar input) {
		width: 100% !important;
		color: var(--text-color) !important;
	}

	.about-search :global(#search-bar input::placeholder) {
		color: var(--content-meta);
	}

	.about-search :global(#search-bar svg) {
		color: var(--content-meta);
	}

	.about-search :global(#search-panel) {
		top: calc(100% + 0.5rem) !important;
		left: 0 !important;
		right: auto !important;
		width: 100% !important;
	}

	.about-sayings {
		min-height: 2.6em;
		max-width: 44rem;
	}

	/* ===== 左中：标签面板 ===== */
	.about-tags-panel {
		grid-area: tags;
		padding: 1.1rem 1.2rem;
	}

	.about-panel__title {
		margin: 0 0 0.8rem;
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--content-meta);
	}

	.about-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
	}

	.about-tag {
		padding: 0.32rem 0.7rem;
		border-radius: 999px;
		background: var(--btn-regular-bg);
		border: 1px solid var(--line-divider);
		color: var(--btn-content);
		font-size: 0.8rem;
	}

	/* ===== 左下：圆形统计图 + 社交 ===== */
	.about-stats {
		grid-area: stats;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.1rem;
	}

	.about-donut {
		width: 100%;
		max-width: 17rem;
	}

	.about-social {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.5rem;
	}

	.about-social__link {
		display: grid;
		place-items: center;
		width: 2.5rem;
		height: 2.5rem;
		border-radius: 0.7rem;
		background: var(--btn-regular-bg);
		border: 1px solid var(--line-divider);
		color: var(--btn-content);
		text-decoration: none;
		transition: transform 0.15s ease, background-color 0.15s ease, color 0.15s ease;
	}

	.about-social__link:hover {
		background: color-mix(in oklab, var(--btn-regular-bg) 70%, var(--primary));
		color: var(--primary);
		transform: translateY(-2px);
	}

	.about-social__link :global(svg) {
		font-size: 1.3rem;
	}

	/* ===== 右上：时钟面板 ===== */
	.about-clock-panel {
		grid-area: clock;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 1.5rem;
		min-height: clamp(250px, 26vh, 270px);
	}

	/* ===== 右下：横向项目卡片带 ===== */
	.about-projects {
		grid-area: projects;
		min-width: 0;
	}

	.about-projects__title {
		margin: 0 0 1rem;
		font-size: clamp(1.2rem, 1.6vw, 1.5rem);
		font-weight: 800;
		color: var(--text-color);
	}

	.about-projects__title-en {
		color: var(--content-meta);
		font-weight: 600;
	}

	.about-projects__grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 1.25rem;
	}

	.project-card {
		min-width: 0;
		display: flex;
		flex-direction: column;
		overflow: hidden;
	}

	.project-card__cover {
		width: 100%;
		aspect-ratio: 16 / 9;
		background: color-mix(in oklab, var(--btn-regular-bg) 60%, transparent);
		border-bottom: 1px solid var(--line-divider);
	}

	.project-card__body {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding: 0.9rem;
	}

	.project-card__title {
		margin: 0;
		font-size: 0.95rem;
		font-weight: 700;
		color: var(--text-color);
	}

	.project-card__desc {
		margin: 0;
		font-size: 0.78rem;
		line-height: 1.6;
		color: var(--content-meta);
		display: -webkit-box;
		overflow: hidden;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
	}

	.project-card__link {
		margin-top: auto;
		font-size: 0.8rem;
		font-weight: 600;
		color: var(--primary);
		text-decoration: none;
	}

	/* ===== 响应式 ===== */
	@media (max-width: 1279px) {
		.about-page {
			grid-template-columns: 280px minmax(0, 1fr) 320px;
		}

		.about-projects__grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	@media (max-width: 1023px) {
		.about-page {
			grid-template-columns: 260px minmax(0, 1fr);
			grid-template-areas:
				"avatar  hero"
				"tags    hero"
				"stats   projects"
				"clock   clock";
		}

		.about-projects__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 639px) {
		.about-page {
			grid-template-columns: 1fr;
			grid-template-areas:
				"avatar"
				"hero"
				"tags"
				"stats"
				"clock"
				"projects";
		}

		.about-avatar {
			margin: 0 auto;
		}

		.about-hero {
			align-items: center;
			text-align: center;
		}

		.about-projects__grid {
			grid-template-columns: repeat(1, minmax(0, 1fr));
		}
	}
</style>
