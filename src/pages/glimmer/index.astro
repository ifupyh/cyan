---
import { Icon } from "astro-icon/components";
import GlimmerNote from "@/components/pages/glimmer/GlimmerNote.astro";
import GlimmerPolaroid from "@/components/pages/glimmer/GlimmerPolaroid.astro";
import { galleryConfig } from "@/config";
import { moments } from "@/data/moments";
import { myTools, thirdPartyTools } from "@/data/tools";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { getAnimeList } from "@/utils/anime-utils";
import { getBangumiData } from "@/utils/bangumi-utils";
import { getFeaturedSteamGames } from "@/utils/steam-utils";
import { getInterviewCategories } from "@/utils/interview-utils";
import { getAlbumCover, scanAlbumPhotos } from "@/utils/gallery-utils";
import { url } from "@/utils/url-utils";

// 相册摘要
const albums = galleryConfig.albums.map((album) => {
	const photos = scanAlbumPhotos(album.id);
	const cover = getAlbumCover(album, photos);
	return { ...album, cover, photoCount: photos.length };
});
// 按标签分组：每个标签一个容器入口（游戏/生活/学习/工作/加密）
const tagMap = new Map<string, string>();
for (const album of albums) {
	for (const tag of album.tags || []) {
		if (!tagMap.has(tag)) tagMap.set(tag, album.cover);
	}
}
const albumTagGroups = [...tagMap.entries()].map(([tag, cover]) => ({ tag, cover }));

// 追番摘要
const animeList = await getAnimeList();
const previewAnime = animeList.slice(0, 4);

// 番组计划：书籍、音乐、游戏三个独立模块
const { bangumiData } = await getBangumiData();
const previewBook = (bangumiData.book || []).slice(0, 4);
const previewMusic = (bangumiData.music || []).slice(0, 4);
const steamGames = getFeaturedSteamGames();
const previewSteam = steamGames;

// 工具摘要
const previewTools = [...myTools, ...thirdPartyTools].slice(0, 4);

// 面试题库（八股文）摘要
const previewInterviewCategories = (await getInterviewCategories()).slice(0, 8);
---

<MainGridLayout
  title="浮光集"
  description="一面收住照片，一面摊开短句。把看见的、想起的，都放在这里。"
>
  <!-- Hero：直接裸露在背景上 -->
  <div class="mb-8 md:mb-12 onload-animation">
    <h1 class="text-4xl md:text-5xl font-medium tracking-tight text-black/85 dark:text-white/85 leading-tight">
      浮光集
    </h1>
    <p class="mt-3 text-base text-black/55 dark:text-white/55 leading-relaxed max-w-xl">
      一面收住照片，一面摊开短句。把看见的、想起的，都放在这里。
    </p>
  </div>

  <!-- 相册集 -->
  <section class="card-base-transparent px-5 py-5 md:px-7 md:py-6 mb-8 onload-animation">
    <div class="flex items-end justify-between gap-4 mb-5">
      <div class="flex items-baseline gap-3">
        <h2 class="text-xl font-semibold text-black/85 dark:text-white/85">相册集</h2>
        <span class="text-[0.7rem] text-black/40 dark:text-white/40 uppercase tracking-[0.18em]">
          Album Shelf
        </span>
      </div>
      <a
        href={url("/gallery/")}
        class="inline-flex items-center gap-1 text-xs font-medium text-(--primary) hover:underline whitespace-nowrap"
      >
        查看全部
        <Icon is:inline name="fa7-solid:arrow-right" class="text-[0.7rem]" />
      </a>
    </div>
    {
      albumTagGroups.length > 0 ? (
        <div class="glimmer-album-grid">
          {albumTagGroups.map((group) => (
            <GlimmerPolaroid
              id={group.tag}
              name={group.tag}
              cover={group.cover}
              href={url("/gallery/")}
            />
          ))}
        </div>
      ) : (
        <p class="text-sm text-black/50 dark:text-white/50 py-6 text-center">暂无相册</p>
      )
    }
  </section>

  <!-- Steam 游戏库 -->
  <section class="card-base-transparent px-5 py-5 md:px-7 md:py-6 mb-8 onload-animation">
    <div class="flex items-end justify-between gap-4 mb-5">
      <div class="flex items-baseline gap-3">
        <h2 class="text-xl font-semibold text-black/85 dark:text-white/85">Steam 游戏</h2>
        <span class="text-[0.7rem] text-black/40 dark:text-white/40 uppercase tracking-[0.18em]">
          Steam
        </span>
      </div>
      <a
        href={url("/steam/")}
        class="inline-flex items-center gap-1 text-xs font-medium text-(--primary) hover:underline whitespace-nowrap"
      >
        查看全部
        <Icon is:inline name="fa7-solid:arrow-right" class="text-[0.7rem]" />
      </a>
    </div>
    {
      previewSteam.length > 0 ? (
        <div class="glimmer-tilt-grid">
          {previewSteam.map((game) => (
            <a
              href={game.link}
              target="_blank"
              rel="noopener noreferrer"
              class="glimmer-tilt-card group"
            >
              <div class="glimmer-tilt-card__media">
                <img
                  src={game.cover}
                  alt={game.name}
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <span class="glimmer-tilt-card__title">{game.name}</span>
            </a>
          ))}
        </div>
      ) : (
        <p class="text-sm text-black/50 dark:text-white/50 py-6 text-center">暂无 Steam 游戏数据</p>
      )
    }
  </section>

  <!-- 追番 -->
  <section class="card-base-transparent px-5 py-5 md:px-7 md:py-6 mb-8 onload-animation">
    <div class="flex items-end justify-between gap-4 mb-5">
      <div class="flex items-baseline gap-3">
        <h2 class="text-xl font-semibold text-black/85 dark:text-white/85">追番</h2>
        <span class="text-[0.7rem] text-black/40 dark:text-white/40 uppercase tracking-[0.18em]">
          Anime
        </span>
      </div>
      <a
        href={url("/anime/")}
        class="inline-flex items-center gap-1 text-xs font-medium text-(--primary) hover:underline whitespace-nowrap"
      >
        查看全部
        <Icon is:inline name="fa7-solid:arrow-right" class="text-[0.7rem]" />
      </a>
    </div>
    {
      previewAnime.length > 0 ? (
        <div class="glimmer-tilt-grid">
          {previewAnime.map((anime) => (
            <a
              href={anime.link}
              target="_blank"
              rel="noopener noreferrer"
              class="glimmer-tilt-card group"
            >
              <div class="glimmer-tilt-card__media">
                {anime.poster ? (
                  <img src={anime.poster} alt={anime.title} loading="lazy" decoding="async" />
                ) : (
                  <span class="glimmer-tilt-card__placeholder">🎬</span>
                )}
              </div>
              <span class="glimmer-tilt-card__title">{anime.title}</span>
            </a>
          ))}
        </div>
      ) : (
        <p class="text-sm text-black/50 dark:text-white/50 py-6 text-center">暂无追番数据</p>
      )
    }
  </section>

  <!-- 书籍 -->
  <section class="card-base-transparent px-5 py-5 md:px-7 md:py-6 mb-8 onload-animation">
    <div class="flex items-end justify-between gap-4 mb-5">
      <div class="flex items-baseline gap-3">
        <h2 class="text-xl font-semibold text-black/85 dark:text-white/85">书籍</h2>
        <span class="text-[0.7rem] text-black/40 dark:text-white/40 uppercase tracking-[0.18em]">
          Book
        </span>
      </div>
      <a
        href={url("/bangumi/book/")}
        class="inline-flex items-center gap-1 text-xs font-medium text-(--primary) hover:underline whitespace-nowrap"
      >
        查看全部
        <Icon is:inline name="fa7-solid:arrow-right" class="text-[0.7rem]" />
      </a>
    </div>
    {
      previewBook.length > 0 ? (
        <div class="glimmer-tilt-grid">
          {previewBook.map((item) => (
            <a
              href={`https://bangumi.one/subject/${item.subject.id}`}
              target="_blank"
              rel="noopener noreferrer"
              class="glimmer-tilt-card group"
            >
              <div class="glimmer-tilt-card__media">
                <img
                  src={item.subject.images.common}
                  alt={item.subject.name_cn || item.subject.name}
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <span class="glimmer-tilt-card__title">
                {item.subject.name_cn || item.subject.name}
              </span>
            </a>
          ))}
        </div>
      ) : (
        <p class="text-sm text-black/50 dark:text-white/50 py-6 text-center">暂无书籍数据</p>
      )
    }
  </section>

  <!-- 音乐 -->
  <section class="card-base-transparent px-5 py-5 md:px-7 md:py-6 mb-8 onload-animation">
    <div class="flex items-end justify-between gap-4 mb-5">
      <div class="flex items-baseline gap-3">
        <h2 class="text-xl font-semibold text-black/85 dark:text-white/85">音乐</h2>
        <span class="text-[0.7rem] text-black/40 dark:text-white/40 uppercase tracking-[0.18em]">
          Music
        </span>
      </div>
      <a
        href={url("/bangumi/music/")}
        class="inline-flex items-center gap-1 text-xs font-medium text-(--primary) hover:underline whitespace-nowrap"
      >
        查看全部
        <Icon is:inline name="fa7-solid:arrow-right" class="text-[0.7rem]" />
      </a>
    </div>
    {
      previewMusic.length > 0 ? (
        <div class="glimmer-tilt-grid">
          {previewMusic.map((item) => (
            <a
              href={`https://bangumi.one/subject/${item.subject.id}`}
              target="_blank"
              rel="noopener noreferrer"
              class="glimmer-tilt-card group"
            >
              <div class="glimmer-tilt-card__media">
                <img
                  src={item.subject.images.common}
                  alt={item.subject.name_cn || item.subject.name}
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <span class="glimmer-tilt-card__title">
                {item.subject.name_cn || item.subject.name}
              </span>
            </a>
          ))}
        </div>
      ) : (
        <p class="text-sm text-black/50 dark:text-white/50 py-6 text-center">暂无音乐数据</p>
      )
    }
  </section>

  <!-- 工具 -->
  <section class="card-base-transparent px-5 py-5 md:px-7 md:py-6 mb-8 onload-animation">
    <div class="flex items-end justify-between gap-4 mb-5">
      <div class="flex items-baseline gap-3">
        <h2 class="text-xl font-semibold text-black/85 dark:text-white/85">工具</h2>
        <span class="text-[0.7rem] text-black/40 dark:text-white/40 uppercase tracking-[0.18em]">
          Tools
        </span>
      </div>
      <a
        href={url("/tools/")}
        class="inline-flex items-center gap-1 text-xs font-medium text-(--primary) hover:underline whitespace-nowrap"
      >
        查看全部
        <Icon is:inline name="fa7-solid:arrow-right" class="text-[0.7rem]" />
      </a>
    </div>
    <div class="glimmer-tilt-grid">
      {previewTools.map((tool) => (
        <a
          href={tool.url}
          target="_blank"
          rel="noopener noreferrer"
          class="glimmer-tilt-card group"
        >
          <div class="glimmer-tilt-card__media glimmer-tilt-card__media--tool">
            <span
              class="glimmer-tilt-card__tool-icon"
              style={`background: ${tool.accent}`}
            >
              <Icon is:inline name={tool.icon} class="text-[1.5rem]" />
            </span>
          </div>
          <span class="glimmer-tilt-card__title">{tool.name}</span>
        </a>
      ))}
    </div>
  </section>

  <!-- 面试题库（八股文） -->
  <section class="card-base-transparent px-5 py-5 md:px-7 md:py-6 mb-8 onload-animation">
    <div class="flex items-end justify-between gap-4 mb-5">
      <div class="flex items-baseline gap-3">
        <h2 class="text-xl font-semibold text-black/85 dark:text-white/85">八股文</h2>
        <span class="text-[0.7rem] text-black/40 dark:text-white/40 uppercase tracking-[0.18em]">
          Interview
        </span>
      </div>
      <a
        href={url("/interview/")}
        class="inline-flex items-center gap-1 text-xs font-medium text-(--primary) hover:underline whitespace-nowrap"
      >
        查看更多
        <Icon is:inline name="fa7-solid:arrow-right" class="text-[0.7rem]" />
      </a>
    </div>
    <div class="glimmer-tilt-grid">
      {previewInterviewCategories.map((cat) => (
        <a
          href={url(`/interview/${cat.slug}/`)}
          class="glimmer-tilt-card group"
        >
          <div class="glimmer-tilt-card__media glimmer-tilt-card__media--tool">
            <span class="glimmer-tilt-card__tool-icon" style="background: var(--primary)">
              <Icon is:inline name={cat.icon} class="text-[1.5rem]" />
            </span>
          </div>
          <span class="glimmer-tilt-card__title">{cat.name}</span>
        </a>
      ))}
    </div>
  </section>

  <!-- 碎语 -->
  <section class="card-base-transparent px-5 py-5 md:px-7 md:py-6 mb-8 onload-animation">
    <div class="flex items-end justify-between gap-4 mb-5">
      <div class="flex items-baseline gap-3">
        <h2 class="text-xl font-semibold text-black/85 dark:text-white/85">碎语</h2>
        <span class="text-[0.7rem] text-black/40 dark:text-white/40 uppercase tracking-[0.18em]">
          All Notes
        </span>
      </div>
    </div>
    <div class="glimmer-notes-grid">
      {moments.map((moment) => (
        <GlimmerNote moment={moment} />
      ))}
    </div>
  </section>
</MainGridLayout>

<style>
  .glimmer-album-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, 118px);
    justify-content: start;
    gap: 1.5rem 1.25rem;
  }

  .glimmer-tilt-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, 132px);
    justify-content: start;
    gap: 1.5rem 1.25rem;
  }

  .glimmer-tilt-card {
    --tilt: -1.2deg;
    position: relative;
    display: block;
    padding: 9px 9px 26px;
    transform: rotate(var(--tilt));
    border: 1px solid var(--line-divider);
    border-radius: 2px;
    background: var(--card-bg);
    box-shadow: 0 10px 22px rgb(0 0 0 / 0.08);
    color: inherit;
    text-decoration: none;
    transition:
      transform 0.24s ease,
      box-shadow 0.24s ease;
  }

  .glimmer-tilt-card:nth-child(2n) {
    --tilt: 1.3deg;
  }

  .glimmer-tilt-card:nth-child(3n) {
    --tilt: -0.6deg;
  }

  .glimmer-tilt-card:hover {
    transform: rotate(0deg) translateY(-4px);
    box-shadow: 0 14px 28px rgb(0 0 0 / 0.12);
  }

  .glimmer-tilt-card__media {
    overflow: hidden;
    border: 1px solid var(--line-divider);
    background: color-mix(in oklab, var(--btn-regular-bg) 60%, transparent);
  }

  .glimmer-tilt-card__media img {
    display: block;
    width: 100%;
    aspect-ratio: 2 / 3;
    object-fit: cover;
  }

  .glimmer-tilt-card__placeholder {
    display: grid;
    aspect-ratio: 2 / 3;
    place-items: center;
    font-size: 2rem;
    color: var(--content-meta);
  }

  .glimmer-tilt-card__media--tool {
    display: grid;
    aspect-ratio: 1 / 1;
    place-items: center;
  }

  .glimmer-tilt-card__tool-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border-radius: 0.75rem;
    color: white;
  }

  .glimmer-tilt-card__title {
    position: absolute;
    right: 8px;
    bottom: 8px;
    left: 8px;
    overflow: hidden;
    color: var(--content-meta);
    font-size: 0.8rem;
    text-align: center;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .glimmer-notes-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(238px, 1fr));
    gap: 1.5rem;
    align-items: start;
  }

  @media (max-width: 640px) {
    .glimmer-album-grid,
    .glimmer-tilt-grid {
      grid-template-columns: repeat(auto-fill, 108px);
      gap: 1.25rem 1rem;
    }
  }
</style>
