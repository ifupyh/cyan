---
import PostListPagination from "@/components/common/PostListPagination.astro";
import PostPage from "@/components/layout/PostPage.astro";
import { siteConfig } from "@/config";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { getSortedPosts } from "@/utils/content-utils";
import { url } from "@/utils/url-utils";

// 文章列表第 1 页（/posts/）
const posts = await getSortedPosts();
const total = posts.length;
const pageSize = siteConfig.pagination.postsPerPage;
const totalPages = Math.max(1, Math.ceil(total / pageSize));
const pagePosts = posts.slice(0, pageSize);
const basePath = url("/posts");
---

<MainGridLayout title="文章">
  <PostPage page={{ data: pagePosts }} />
  {
    totalPages > 1 && (
      <PostListPagination
        currentPage={1}
        totalPages={totalPages}
        basePath={basePath}
        class="mb-4"
      />
    )
  }
</MainGridLayout>
