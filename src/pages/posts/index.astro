---
import PostListPagination from "@/components/common/PostListPagination.astro";
import PostPage from "@/components/layout/PostPage.astro";
import { siteConfig } from "@/config";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { getSortedPosts } from "@/utils/content-utils";
import { url } from "@/utils/url-utils";

// 文章列表第 1 页（/posts/）
const posts = await getSortedPosts();
const total = posts.length;
const pageSize = siteConfig.pagination.postsPerPage;
const totalPages = Math.max(1, Math.ceil(total / pageSize));
const pagePosts = posts.slice(0, pageSize);
const basePath = url("/posts");
---

<MainGridLayout title="文章">
  <div class="post-list-header card-base px-4 py-5 md:px-6 md:py-6 mb-4 onload-animation flex items-end justify-between gap-4">
    <h1 class="text-2xl md:text-3xl font-bold text-black/90 dark:text-white/90">
      全部文章
    </h1>
    <span class="text-sm text-black/50 dark:text-white/50 whitespace-nowrap">
      共 {total} 篇文章
    </span>
  </div>
  <PostPage page={{ data: pagePosts }} />
  {
    totalPages > 1 && (
      <PostListPagination
        currentPage={1}
        totalPages={totalPages}
        basePath={basePath}
        class="mb-4"
      />
    )
  }
</MainGridLayout>
