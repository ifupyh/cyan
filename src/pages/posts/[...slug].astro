---
import { render } from "astro:content";
import * as path from "node:path";
import Comment from "@components/comment/index.astro";
import Markdown from "@components/common/Markdown.astro";
import EncryptedPost from "@components/features/EncryptedPost.astro";
import KatexManager from "@components/features/KatexManager.astro";
import License from "@components/misc/License.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getSortedPosts } from "@utils/content-utils";
import {
	getFileDirFromPath,
	getPostUrlBySlug,
	removeFileExtension,
} from "@utils/url-utils";
import { Icon } from "astro-icon/components";
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import CoverImage from "@/components/common/CoverImage.astro";
import PostMetadata from "@/components/layout/PostMeta.astro";
import SharePoster from "@/components/misc/SharePoster.svelte";
import { coverImageConfig } from "@/config/coverImageConfig";
import { licenseConfig } from "@/config/licenseConfig";
import { profileConfig } from "@/config/profileConfig";
import { siteConfig } from "@/config/siteConfig";
import { sponsorConfig } from "@/config/sponsorConfig";
import { formatDateToYYYYMMDD } from "@/utils/date-utils";
import { getApiUrlList, processCoverImageSync } from "@/utils/image-utils";
import { url } from "@/utils/url-utils";

export async function getStaticPaths() {
	const blogEntries = await getSortedPosts();
	return blogEntries.map((entry) => {
		// 将 id 转换为 slug（移除扩展名）以匹配路由参数
		const slug = removeFileExtension(entry.id);
		return {
			params: { slug },
			props: { entry },
		};
	});
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const { remarkPluginFrontmatter } = await render(entry);

const bannerPostMeta = {
	title: entry.data.title,
	published: entry.data.published,
	updated: entry.data.updated,
	words: remarkPluginFrontmatter.words,
	minutes: remarkPluginFrontmatter.minutes,
};

// 处理随机图：如果image为"api"，则从配置的API获取随机图
const processedImage = processCoverImageSync(entry.data.image, entry.id);
const preservePostCoverRatio = false;
const forcePostTitleBreak = false;
const postMarkdownClass = "";
const apiUrls = getApiUrlList(entry.data.image, entry.id);

let posterCoverUrl = processedImage;
if (processedImage) {
	const isLocal = !(
		processedImage.startsWith("/") ||
		processedImage.startsWith("http") ||
		processedImage.startsWith("https") ||
		processedImage.startsWith("data:")
	);
	if (isLocal) {
		const basePath = getFileDirFromPath(entry.filePath || "");
		const files = import.meta.glob<ImageMetadata>("../../**", {
			import: "default",
		});
		let normalizedPath = path
			.normalize(path.join("../../", basePath, processedImage))
			.replace(/\\/g, "/");
		const file = files[normalizedPath];
		if (file) {
			const img = await file();
			posterCoverUrl = img.src;
		}
	}
}

// 处理头像URL
let posterAvatarUrl: string | null = profileConfig.avatar || null;
if (posterAvatarUrl) {
	const isLocalAvatar = !(
		posterAvatarUrl.startsWith("/") ||
		posterAvatarUrl.startsWith("http") ||
		posterAvatarUrl.startsWith("https") ||
		posterAvatarUrl.startsWith("data:")
	);
	if (isLocalAvatar) {
		const files = import.meta.glob<ImageMetadata>("../../**", {
			import: "default",
		});
		const normalizedPath = path
			.normalize(path.join("../../", posterAvatarUrl))
			.replace(/\\/g, "/");
		const file = files[normalizedPath];
		if (file) {
			const img = await file();
			posterAvatarUrl = img.src;
		}
	}
}

dayjs.extend(utc);

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	headline: entry.data.title,
	description: entry.data.description || entry.data.title,
	keywords: entry.data.tags,
	author: {
		"@type": "Person",
		name: profileConfig.name,
		url: Astro.site,
	},
	datePublished: formatDateToYYYYMMDD(entry.data.published),
	inLanguage: entry.data.lang
		? entry.data.lang.replace("_", "-")
		: siteConfig.lang.replace("_", "-"),
	// TODO include cover image here
};
---

<MainGridLayout
  banner={processedImage}
  title={entry.data.title}
  description={entry.data.description}
  lang={entry.data.lang}
  setOGTypeArticle={true}
  postSlug={entry.id}
  postCategory={entry.data.category || undefined}
  headings={headings}
  bannerPostMeta={bannerPostMeta}
  bannerPostAiSummary={entry.data.aiSummary}
>
  <!-- KaTeX 按需加载 - 仅在文章页面 -->
  <KatexManager slot="head" />
  
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(jsonLd)}
  />
  <div
    class="flex w-full rounded-(--radius-large) overflow-hidden relative mb-4"
  >
    <div
      id="post-container"
      class:list={[
        "card-base z-10 px-6 md:px-9 pt-6 pb-4 relative w-full ",
        {},
      ]}
    >
      <!-- word count and reading time -->
      <div
        class="flex flex-row text-black/30 dark:text-white/30 gap-5 mb-3 transition onload-animation"
      >
        <div class="flex flex-row items-center">
          <div
            class="transition h-6 w-6 rounded-md bg-black/5 dark:bg-white/10 text-black/50 dark:text-white/50 flex items-center justify-center mr-2"
          >
            <Icon is:inline name="material-symbols:notes-rounded" />
          </div>
          <div class="text-sm">
            {remarkPluginFrontmatter.words}
            {" " + i18n(I18nKey.wordsCount)}
          </div>
        </div>
        <div class="flex flex-row items-center">
          <div
            class="transition h-6 w-6 rounded-md bg-black/5 dark:bg-white/10 text-black/50 dark:text-white/50 flex items-center justify-center mr-2"
          >
            <Icon is:inline name="material-symbols:schedule-outline-rounded" />
          </div>
          <div class="text-sm">
            {remarkPluginFrontmatter.minutes}
            {
              " " +
                i18n(
                  remarkPluginFrontmatter.minutes === 1
                    ? I18nKey.minuteCount
                    : I18nKey.minutesCount
                )
            }
          </div>
        </div>
        {entry.data.password && (
          <div class="flex flex-row items-center">
            <div
              class="transition h-6 w-6 rounded-md bg-black/5 dark:bg-white/10 text-black/50 dark:text-white/50 flex items-center justify-center mr-2"
            >
              <Icon is:inline name="material-symbols:lock-outline" />
            </div>
            <div class="text-sm">
              {i18n(I18nKey.postEncrypted)}
            </div>
          </div>
        )}
      </div>

      <!-- title -->
      <div class="relative onload-animation">
        <div
          data-pagefind-body
          data-pagefind-weight="10"
          data-pagefind-meta="title"
          class:list={[
            "transition w-full block font-bold mb-3 text-3xl md:text-[2.25rem]/[2.75rem] text-black/90 dark:text-white/90 md:before:w-1 before:h-5 before:rounded-md before:bg-(--primary) before:absolute before:top-3 before:-left-4.5",
            forcePostTitleBreak && "post-title-force-break",
          ]}
        >
          {entry.data.title}
        </div>
      </div>

      <!-- metadata -->
      <div class="onload-animation">
        <PostMetadata
          className="mb-5"
          published={entry.data.published}
          updated={entry.data.updated}
          tags={entry.data.tags}
          category={entry.data.category || undefined}
          id={entry.id}
          aiPolished={entry.data.aiPolished}
        />
        {
          !processedImage && (
            <div class="border-(--line-divider) border-dashed border-b mt-3 mb-5" />
          )
        }
      </div>

      <!-- always show cover as long as it has one -->

      {
        processedImage &&
        coverImageConfig.enableInPost &&
        (
          <div style="margin-top:1rem;">
            <CoverImage
              id="post-cover"
              src={processedImage}
              basePath={getFileDirFromPath(entry.filePath || '')}
              class:list={[
                "mb-8 rounded-xl banner-container onload-animation",
                preservePostCoverRatio ? "post-cover-preserve-ratio" : "",
              ]}
              preview={false}
              preserveAspectRatio={preservePostCoverRatio}
              apiUrls={apiUrls}
            />
          </div>
        )
      }

      {entry.data.password ? (
        <EncryptedPost password={entry.data.password} slug={entry.id} hint={entry.data.passwordHint}>
          <Markdown class={`mb-6 markdown-content onload-animation ${postMarkdownClass}`}>
            <Content />
          </Markdown>

          {/* 打赏按钮 & 分享按钮 */}
          {
            (siteConfig.post.sharePoster || (sponsorConfig.showButtonInPost && siteConfig.pages.sponsor)) && (
              <div class="mb-6 rounded-xl onload-animation">
                <div class="p-6 rounded-xl">
                  <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
                    <div class="flex items-center gap-3 flex-1">
                      <div class="h-12 w-12 rounded-lg bg-(--primary) flex items-center justify-center text-white dark:text-black/70 shrink-0">
                        <Icon is:inline
                          name={sponsorConfig.showButtonInPost &&
                          siteConfig.pages.sponsor
                            ? "material-symbols:favorite"
                            : "material-symbols:share"}
                          class="text-2xl"
                        />
                      </div>
                      <div>
                        <h3 class="text-lg font-semibold text-neutral-900 dark:text-neutral-100 mb-1">
                          {
                            sponsorConfig.showButtonInPost && siteConfig.pages.sponsor
                              ? i18n(I18nKey.sponsorButton)
                              : i18n(I18nKey.shareOnSocial)
                          }
                        </h3>
                        <p class="text-sm text-neutral-600 dark:text-neutral-400">
                          {
                            sponsorConfig.showButtonInPost && siteConfig.pages.sponsor
                              ? i18n(I18nKey.sponsorButtonText)
                              : i18n(I18nKey.shareOnSocialDescription)
                          }
                        </p>
                      </div>
                    </div>
                    <div class="flex items-center gap-3">
                      {
                        siteConfig.post.sharePoster && (
                          <SharePoster
                            client:load
                            title={entry.data.title}
                            author={profileConfig.name}
                            description={entry.data.description || entry.data.title}
                            pubDate={formatDateToYYYYMMDD(entry.data.published)}
                            coverImage={posterCoverUrl}
                            url={Astro.url.href}
                            siteTitle={siteConfig.title}
                            avatar={posterAvatarUrl}
                          />
                        )
                      }
                      {
                        sponsorConfig.showButtonInPost && siteConfig.pages.sponsor && (
                          <a
                            href={url("/sponsor/")}
                            class="inline-flex items-center gap-2 px-6 py-3 bg-(--primary) text-white dark:text-black/70 rounded-lg font-medium hover:bg-(--primary)/80 hover:scale-105 active:scale-95 transition-all whitespace-nowrap"
                          >
                            <span>{i18n(I18nKey.sponsor)}</span>
                            <Icon is:inline name="fa7-solid:arrow-right" class="text-sm" />
                          </a>
                        )
                      }
                    </div>
                  </div>
                </div>
              </div>
            )
          }

          {
            licenseConfig.enable && (
              <License
                title={entry.data.title}
                id={entry.id}
                pubDate={entry.data.published}
                author={entry.data.author}
                sourceLink={entry.data.sourceLink}
                licenseName={entry.data.licenseName}
                licenseUrl={entry.data.licenseUrl}
                class="mb-6 rounded-xl license-container onload-animation"
              />
            )
          }
        </EncryptedPost>
      ) : (
        <>
          <Markdown class={`mb-6 markdown-content onload-animation ${postMarkdownClass}`}>
              <Content />
            </Markdown>

          {/* 打赏按钮 & 分享按钮 */}
          {
            (siteConfig.post.sharePoster || (sponsorConfig.showButtonInPost && siteConfig.pages.sponsor)) && (
              <div class="mb-6 rounded-xl onload-animation">
                <div class="p-6 rounded-xl">
                  <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
                    <div class="flex items-center gap-3 flex-1">
                      <div class="h-12 w-12 rounded-lg bg-(--primary) flex items-center justify-center text-white dark:text-black/70 shrink-0">
                        <Icon is:inline
                          name={sponsorConfig.showButtonInPost &&
                          siteConfig.pages.sponsor
                            ? "material-symbols:favorite"
                            : "material-symbols:share"}
                          class="text-2xl"
                        />
                      </div>
                      <div>
                        <h3 class="text-lg font-semibold text-neutral-900 dark:text-neutral-100 mb-1">
                          {
                            sponsorConfig.showButtonInPost && siteConfig.pages.sponsor
                              ? i18n(I18nKey.sponsorButton)
                              : i18n(I18nKey.shareOnSocial)
                          }
                        </h3>
                        <p class="text-sm text-neutral-600 dark:text-neutral-400">
                          {
                            sponsorConfig.showButtonInPost && siteConfig.pages.sponsor
                              ? i18n(I18nKey.sponsorButtonText)
                              : i18n(I18nKey.shareOnSocialDescription)
                          }
                        </p>
                      </div>
                    </div>
                    <div class="flex items-center gap-3">
                      {
                        siteConfig.post.sharePoster && (
                          <SharePoster
                            client:load
                            title={entry.data.title}
                            author={profileConfig.name}
                            description={entry.data.description || entry.data.title}
                            pubDate={formatDateToYYYYMMDD(entry.data.published)}
                            coverImage={posterCoverUrl}
                            url={Astro.url.href}
                            siteTitle={siteConfig.title}
                            avatar={posterAvatarUrl}
                          />
                        )
                      }
                      {
                        sponsorConfig.showButtonInPost && siteConfig.pages.sponsor && (
                          <a
                            href={url("/sponsor/")}
                            class="inline-flex items-center gap-2 px-6 py-3 bg-(--primary) text-white dark:text-black/70 rounded-lg font-medium hover:bg-(--primary)/80 hover:scale-105 active:scale-95 transition-all whitespace-nowrap"
                          >
                            <span>{i18n(I18nKey.sponsor)}</span>
                            <Icon is:inline name="fa7-solid:arrow-right" class="text-sm" />
                          </a>
                        )
                      }
                    </div>
                  </div>
                </div>
              </div>
            )
          }

          {
            licenseConfig.enable && (
              <License
                title={entry.data.title}
                id={entry.id}
                pubDate={entry.data.published}
                author={entry.data.author}
                sourceLink={entry.data.sourceLink}
                licenseName={entry.data.licenseName}
                licenseUrl={entry.data.licenseUrl}
                class="mb-6 rounded-xl license-container onload-animation"
              />
            )
          }
        </>
      )}
    </div>
  </div>

  <!-- 上次编辑时间 -->
  {
    siteConfig.post.showLastModified && (() => {
      const lastModified = dayjs(entry.data.updated || entry.data.published);
      const dateStr = lastModified.format("YYYY-MM-DD");
      const outdatedThreshold = siteConfig.post.outdatedThreshold ?? 1;

      // 1. 預設加上 hidden 隱藏，並把時間與閾值綁在 data-* 屬性
      return (
        <div 
          id="outdated-card" 
          class="card-base p-6 mb-4 hidden" 
          data-date={lastModified.toISOString()} 
          data-threshold={outdatedThreshold}
        >
          <div class="flex items-center gap-2">
            <div class="transition h-9 w-9 rounded-lg overflow-hidden relative flex items-center justify-center mr-0">
              <Icon is:inline
                name="material-symbols:history-rounded"
                class="text-4xl text-(--primary) transition-transform group-hover:translate-x-0.5 bg-(--enter-btn-bg) p-2 rounded-md"
              />
            </div>

            <div class="flex flex-col gap-0.1">
              <div class="text-[1.0rem] leading-tight text-black/75 dark:text-white/75">
                {i18n(I18nKey.lastModifiedPrefix)}{dateStr}
                <span id="days-ago-text" data-template={i18n(I18nKey.lastModifiedDaysAgo)}></span>
              </div>
              <p id="outdated-warning" class="text-[0.8rem] leading-tight text-black/75 dark:text-white/75 hidden">
                {i18n(I18nKey.lastModifiedOutdated)}
              </p>
            </div>
          </div>
        </div>
      );
    })()
  }

  <script>
    import dayjs from "dayjs";

    const card = document.getElementById('outdated-card');
    
    if (card) {
      // 讀取伺服器給的日期，並用 dayjs 直接算出差異天數
      const lastModified = dayjs(card.dataset.date);
      const daysDiff = dayjs().diff(lastModified, "day");
      const threshold = Number(card.dataset.threshold);

      // 如果超過閾值，就顯示卡片與提示文字
      if (daysDiff >= threshold) {
        card.classList.remove('hidden');

        if (daysDiff >= 1) {
          const textEl = document.getElementById('days-ago-text');
          if (textEl && textEl.dataset.template) {
            textEl.textContent = `，${textEl.dataset.template.replace("{days}", daysDiff.toString())}`;
          }
          
          const warningEl = document.getElementById('outdated-warning');
          if (warningEl) {
            warningEl.classList.remove('hidden');
          }
        }
      }
    }
  </script>

  <!-- 评论 -->
  {entry.data.comment && !entry.data.password && <Comment post={entry} />}
</MainGridLayout>

<style is:global>
  /* Keep selected 2:1 article covers complete at every viewport size. */
  #post-cover.post-cover-preserve-ratio.banner-container {
    aspect-ratio: 2 / 1;
    height: auto !important;
    min-height: 0 !important;
  }

  #post-cover.post-cover-preserve-ratio.banner-container picture,
  #post-cover.post-cover-preserve-ratio.banner-container img {
    display: block;
    width: 100%;
    height: auto;
  }

  #post-cover.post-cover-preserve-ratio.banner-container picture {
    aspect-ratio: 2 / 1;
    overflow: hidden;
  }

  #post-cover.post-cover-preserve-ratio.banner-container img {
    aspect-ratio: 2 / 1;
    object-fit: contain !important;
    object-position: center;
  }

  #post-container .post-title-force-break {
    white-space: pre-line;
  }

  @media (prefers-reduced-motion: reduce) {
  }

  @media (max-width: 640px) {
  }

  @media (hover: hover) {
  }

  @keyframes monthly-heading-sweep {
    from {
      background-size: 0 42%;
    }
    to {
      background-size: 100% 42%;
    }
  }

  @keyframes monthly-automation-title-flow {
    to {
      background-position: 100% 50%;
    }
  }

  @keyframes monthly-fix-notes-enter {
    from {
      opacity: 0.35;
      transform: translateY(-0.3rem);
    }
  }

  @media (hover: hover) {
  }

  @media (hover: hover) {
  }

  @keyframes monthly-loading-orbit {
    to { transform: rotate(360deg); }
  }

  @keyframes monthly-girl-float {
    0%, 100% { transform: translateY(0) rotate(-0.25deg); }
    50% { transform: translateY(-0.46rem) rotate(0.25deg); }
  }

  @media (hover: hover) {
  }

  @keyframes monthly-friend-sheen {
    0% {
      opacity: 0;
      transform: translate3d(-38%, 0, 0) skewX(-8deg);
    }

    14% {
      opacity: 0.62;
    }

    72% {
      opacity: 0.48;
    }

    100% {
      opacity: 0;
      transform: translate3d(38%, 0, 0) skewX(-8deg);
    }
  }

  @media (hover: hover) {
  }

  @media (max-width: 767px) {
  }

  @media (prefers-reduced-motion: reduce) {
  }

  @property --moments-beam-angle {
    syntax: "<angle>";
    inherits: false;
    initial-value: 0deg;
  }

  @keyframes monthly-friend-recommended-outer-beam { 0% { transform: translate3d(-44%, 0, 0) scaleX(0.82); opacity: 0; } 12% { opacity: 0.42; } 58% { opacity: 0.7; } 88% { opacity: 0.3; } 100% { transform: translate3d(44%, 0, 0) scaleX(1.08); opacity: 0; } }
  @keyframes monthly-friend-recommended-beam-primary { 0% { transform: translate3d(-8%, 0, 0) skewX(-10deg); opacity: 0; } 10% { opacity: 0.64; } 46% { opacity: 1; } 83% { opacity: 0.62; } 100% { transform: translate3d(348%, 0, 0) skewX(-10deg); opacity: 0; } }
  @keyframes monthly-friend-recommended-beam-halo { 0% { transform: translate3d(-6%, 0, 0) skewX(-8deg) scaleX(0.9); opacity: 0; } 14% { opacity: 0.28; } 54% { opacity: 0.68; } 84% { opacity: 0.52; } 96% { opacity: 0.22; } 100% { transform: translate3d(300%, 0, 0) skewX(-8deg) scaleX(1.08); opacity: 0; } }
  @keyframes monthly-friend-recommended-surface-sheen { from { background-position: 130% 0; } to { background-position: -170% 0; } }
  @keyframes monthly-friend-recommended-border-glint { 0% { background-position: 118% 0; opacity: 0; } 12% { opacity: 0.42; } 48% { opacity: 0.9; } 86% { opacity: 0.38; } 100% { background-position: -118% 0; opacity: 0; } }
  @keyframes monthly-friend-recommended-title-glow { 0%, 100% { filter: drop-shadow(0 0 0.08rem rgba(239, 175, 34, 0.24)) drop-shadow(0 0 0.18rem rgba(232, 153, 12, 0.12)); } 12% { filter: drop-shadow(0 0 0.14rem rgba(248, 190, 54, 0.46)) drop-shadow(0 0 0.3rem rgba(233, 158, 16, 0.22)); } 48% { filter: drop-shadow(0 0 0.22rem rgba(255, 217, 112, 0.92)) drop-shadow(0 0 0.52rem rgba(233, 151, 8, 0.58)); } 86% { filter: drop-shadow(0 0 0.13rem rgba(248, 190, 54, 0.4)) drop-shadow(0 0 0.28rem rgba(233, 158, 16, 0.18)); } }
  @keyframes monthly-moments-random-swap-glint { 0% { opacity: 0.2; } 38% { opacity: 1; } 100% { opacity: 0.7; } }
  @keyframes monthly-moments-random-swap-icon { from { opacity: 0; transform: translate3d(-0.4rem, 0, 14px) scale(0.86); filter: blur(5px); } 55% { opacity: 0.82; } to { opacity: 1; transform: translateZ(14px) scale(1); filter: blur(0); } }
  @keyframes monthly-moments-random-swap-body { from { opacity: 0; transform: translate3d(0, 0.45rem, 14px) scale(0.985); filter: blur(5px); } 55% { opacity: 0.76; } to { opacity: 1; transform: translateZ(14px) scale(1); filter: blur(0); } }
  @keyframes monthly-moments-random-swap-button { from { opacity: 0; transform: translate3d(0.35rem, 0, 14px) scale(0.92); filter: blur(3px); } to { opacity: 1; transform: translateZ(14px) scale(1); filter: blur(0); } }
  @keyframes monthly-moments-random-countdown { 0%, 100% { opacity: 0.34; transform: translate(-50%, -50%) scale(0.9); } 50% { opacity: 0.52; transform: translate(-50%, -50%) scale(1); } }
  @keyframes monthly-moments-random-border-beam { from { --moments-beam-angle: 0deg; } to { --moments-beam-angle: 360deg; } }
  @keyframes monthly-moments-random-noise-shift { 0%, 100% { transform: translate3d(0, 0, 0) scale(1); } 33% { transform: translate3d(-0.8%, 0.45%, 0) scale(1.012); } 66% { transform: translate3d(0.6%, -0.35%, 0) scale(0.996); } }
  @keyframes monthly-moments-random-sheen-sweep { 0%, 18% { transform: translate3d(-16%, 0, 0) rotate(-3deg); opacity: 0; } 42% { opacity: 0.42; } 68%, 100% { transform: translate3d(16%, 0, 0) rotate(-3deg); opacity: 0; } }

  @media (max-width: 640px) {
  }

  @media (hover: hover) {
  }

  @media (hover: hover) {
  }

  @media (hover: hover) {
  }

