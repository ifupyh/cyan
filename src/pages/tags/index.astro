---
import { Icon } from "astro-icon/components";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { getTagList } from "@/utils/content-utils";
import { getTagUrl } from "@/utils/url-utils";

const tags = await getTagList();

// 计算标签颜色深度 0~1：数量越多颜色越深
const maxCount = Math.max(...tags.map((t) => t.count), 1);
const minCount = Math.min(...tags.map((t) => t.count), 1);
const getDepth = (count: number) => {
	if (maxCount === minCount) return 0.5;
	return (count - minCount) / (maxCount - minCount);
};

---

<MainGridLayout title={i18n(I18nKey.tags)} description={i18n(I18nKey.allTags)}>
    <div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
        <div class="card-base z-10 px-9 py-6 relative w-full">
            <div class="flex flex-wrap gap-2.5">
                {tags.map((t) => (
                    <a href={getTagUrl(t.name)}
                       class="tag-item group inline-flex items-center gap-1.5 rounded-lg
                              h-8 text-sm px-3 transition-all duration-200
                              hover:scale-105 hover:shadow-md"
                       style={`--tag-depth: ${getDepth(t.count)}`}
                    >
                        <span class="font-medium">
                            <span class="opacity-50">#</span>{t.name.trim()}
                        </span>
                        <span class="tag-count-badge text-xs font-bold px-1.5 rounded-md
                                     min-w-[1.5rem] text-center">
                            {t.count}
                        </span>
                    </a>
                ))}
            </div>
        </div>
    </div>

    <!-- 空状态 -->
    {
        tags.length === 0 && (
            <div class="card-base px-8 py-12 text-center">
                <Icon is:inline
                    name="material-symbols:label-off"
                    class="text-5xl text-30 mx-auto mb-4"
                />
                <p class="text-30">{i18n(I18nKey.noData)}</p>
            </div>
        )
    }
</MainGridLayout>
